@model TestingSpareManagement.Models.MaterialRequestViewModel

@{
    ViewData["Title"] = "Material Request";
}

<link rel="stylesheet"
      href="~/css/material-request.css"
      asp-append-version="true" />

<div class="material-request-page-wrapper">
    
    <div class="request-panel">
        <h5><i class="fa-solid fa-file-pen"></i> Request New Spare / Material</h5>


        @if (TempData["EmailSuccessMessage"] != null)
        {
            <div class="alert alert-success" style="font-size: 0.85rem; padding: 10px;">
                ✅ @TempData["EmailSuccessMessage"]
            </div>
        }

        @if (TempData["EmailWarning"] != null)
        {
            <div class="alert alert-warning" style="font-size: 0.85rem; padding: 10px;">
                ⚠️ @TempData["EmailWarning"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="font-size: 0.85rem; padding: 10px;">
                ❌ @TempData["ErrorMessage"]
            </div>
        }


        <form asp-controller="MaterialRequest" asp-action="Submit" method="post">
            @Html.AntiForgeryToken()


            <!-- Interactive Calendar - Material Request -->
            <div class="form-group">
                <label>
                    <i class="fa-solid fa-calendar-days"></i>
                    Select Request Date
                </label>

                <div class="calendar-widget">
                    <div class="cal-header">
                        <button type="button" onclick="changeRequestCalendarMonth(-1)">
                            ◀ Prev
                        </button>

                        <span id="requestCalTitle">
                            @Model.RequestDate.ToString("MMMM yyyy")
                        </span>

                        <button type="button" onclick="changeRequestCalendarMonth(1)">
                            Next ▶
                        </button>
                    </div>

                    <div class="cal-grid" id="requestCalCells"></div>
                </div>

                <input asp-for="RequestDate"
                       type="date"
                       id="requestDateInput"
                       class="form-control-custom"
                       style="margin-top: 8px;" />

                <span asp-validation-for="RequestDate"
                      class="text-danger small"></span>
            </div>


            <!-- Target Project Code -->

            <div class="form-group">
                <label>
                    <i class="fa-solid fa-folder"></i>
                    Target Project Code
                </label>

                <select asp-for="ProjectCode"
                        asp-items="Model.ProjectCodes"
                        class="form-control-custom">
                    <option value="">-- Select Project Code --</option>
                </select>

                <span asp-validation-for="ProjectCode"
                      class="text-danger small"></span>
            </div>

            <!-- Spare Description / Spare Item -->
            <div class="form-group">
                <label for="SpareDescription">
                    <i class="fa-solid fa-microchip"></i>
                    Spare Item
                </label>

                <select asp-for="SpareDescription"
                        id="SpareDescription"
                        class="form-control-custom"
                        required>
                    <option value="">-- Select Spare Item --</option>

                    @if (ViewBag.SpareDescriptions != null)
                    {
                        foreach (string item in ViewBag.SpareDescriptions)
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <span asp-validation-for="SpareDescription"
                      class="text-danger small"></span>
            </div>

            <!-- Part Number -->
            <div class="form-group">
                <label>Part Number (Part No)</label>
                <input asp-for="PartNumber" class="form-control-custom" placeholder="e.g. TCL120X30" />
                <span asp-validation-for="PartNumber" class="text-danger small"></span>
            </div>

            <!-- Brand -->
            <div class="form-group">
                <label>Brand / Manufacturer</label>
                <input asp-for="Brand" class="form-control-custom" placeholder="e.g. Airtac, Foxlink" />
            </div>

            <div class="form-group">
                <label>
                    <i class="fa-solid fa-gears"></i>
                    Testing Station
                </label>

                <select asp-for="TargetMachine"
                        class="form-control-custom">

                    <option value="">-- Select Testing Station --</option>

                    @foreach (var station in Model.TestingStations)
                    {
                        <option value="@station">@station</option>
                    }
                </select>

                <span asp-validation-for="TargetMachine"
                      class="text-danger small"></span>
            </div>


            <!-- Requested Quantity -->
            <div class="form-group">
                <label>Requested Quantity (Pcs/Sets)</label>
                <input asp-for="RequestedQuantity" type="number" class="form-control-custom" placeholder="e.g. 2" value=""/>
                <span asp-validation-for="RequestedQuantity" class="text-danger small"></span>
            </div>


            <!-- Priority Level -->
            <div class="form-group">
                <label>Requirement Priority Level</label>

                <select asp-for="PriorityLevel" class="form-control-custom">
                    <option value="Normal Reorder">Normal Reorder</option>
                    <option value="HIGH - Line Down Risk">HIGH - Line Down Risk </option>
                    <option value="URGENT CRITICAL">URGENT CRITICAL</option>
                </select>

                <span asp-validation-for="PriorityLevel"
                      class="text-danger small"></span>
            </div>


            <!-- Justification -->
            <div class="form-group">
                <label>Justification / Reason for Request</label>
                <textarea asp-for="Justification" class="form-control-custom" rows="3" placeholder="Explain line requirement..."></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-submit-request">
                Submit Request to Admin via Mail
            </button>
        </form>
    </div>

    <div class="queue-panel">
        <div class="queue-header">
            <h5><i class="fa-solid fa-list-check"></i> Material Requisition Requests Queue</h5>
        </div>

        <div class="queue-table-container">
            <table class="queue-table" id="materialRequestTable">
                <thead>
                    <tr>
                        <th>REQ ID</th>
                        <th>REQ DATE</th>
                        <th>SPARE ITEM</th>
                        <th>PROJECT</th>
                        <th>REQUESTED BY</th>
                        <th>PART NO</th>
                        <th>BRAND</th>
                        <th>STATION</th>
                        <th>QTY</th>
                        <th>PRIORITY</th>
                        <th>STATUS</th>
                        <th>ADMIN ACTIONS</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Requests != null && Model.Requests.Any())
                    {
                        foreach (var item in Model.Requests)
                        {
                            var isPending =
                            item.Status == "Pending Admin Approval" ||
                            item.Status == "Pending" ||
                            string.IsNullOrWhiteSpace(item.Status);

                            <tr>
                                <td><strong>@item.ReqId</strong></td>

                                <td>@item.RequestDate.ToString("yyyy-MM-dd")</td>
                                <td><strong class="request-description">@item.SpareDescription</strong></td>
                                <td><strong class="request-project">@item.ProjectCode</strong></td>

                                <td>@item.RequestedBy</td>

                                <td>@item.PartNumber</td>

                                <td>@item.Brand</td>

                                <td>@item.TargetMachine</td>

                                <td> <strong class="request-quantity">@item.RequestedQuantity</strong></td>

                                <td>
                                    @if (item.PriorityLevel == "Urgent" ||
                                                                item.PriorityLevel == "Critical")
                                    {
                                        <span class="priority-urgent">
                                            @item.PriorityLevel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="priority-normal">
                                            @item.PriorityLevel
                                        </span>
                                    }
                                </td>


                                <td>
                                    @if (item.Status == "Approved" ||
                                                                item.Status == "Approved & PR Created")
                                    {
                                        <span class="status-badge status-approved">
                                            Approved 
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="status-badge status-rejected">
                                            Rejected 
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td class="admin-action-cell">
                                    @if (item.Status == "Pending Admin Approval" ||
                                                                item.Status == "Pending" ||
                                                                string.IsNullOrWhiteSpace(item.Status))
                                    {
                                        <div class="admin-action-buttons">
                                            <form asp-controller="MaterialRequest"
                                                  asp-action="Approve"
                                                  method="post"
                                                  onsubmit="return confirm('Approve this material request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn-admin-approve">
                                                    <i class="fa-solid fa-check"></i> Approve
                                                </button>
                                            </form>

                                            <form asp-controller="MaterialRequest"
                                                  asp-action="Reject"
                                                  method="post"
                                                  onsubmit="return confirm('Reject this material request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn-admin-reject">
                                                    <i class="fa-solid fa-xmark"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="admin-action-completed">Processed</span>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12">
                                <div class="empty-state">
                                    <i class="fa-solid fa-inbox"></i>
                                    No material requests found. Submit a request using the form.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Calendar date cell click (highlight only)
        document.querySelectorAll('.date-cell').forEach(cell => {
            cell.addEventListener('click', function () {
                document.querySelectorAll('.date-cell').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
            });
        });

        function deleteRequest(id) {
            if (!id || id <= 0) return;

            if (!confirm('Are you sure you want to delete this material request?')) return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete", "MaterialRequest")';

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const t = document.createElement('input');
                t.type = 'hidden';
                t.name = '__RequestVerificationToken';
                t.value = token.value;
                form.appendChild(t);
            }

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = id;
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }


        (function () {
            const dateInput = document.getElementById("requestDateInput");
            const title = document.getElementById("requestCalTitle");
            const cells = document.getElementById("requestCalCells");

            if (!dateInput || !title || !cells) return;

            function getLocalDateString(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");

                return `${year}-${month}-${day}`;
            }

            let initialDate = dateInput.value
                ? dateInput.value.split("T")[0]
                : getLocalDateString(new Date());

            if (!dateInput.value) {
                dateInput.value = initialDate;
            }

            const initialParts = initialDate.split("-").map(Number);

            let calYear = initialParts[0];
            let calMonth = initialParts[1] - 1;

            function renderRequestCalendar() {
                const monthNames = [
                    "January", "February", "March", "April",
                    "May", "June", "July", "August",
                    "September", "October", "November", "December"
                ];

                title.textContent = `${monthNames[calMonth]} ${calYear}`;

                const firstDay = new Date(calYear, calMonth, 1).getDay();
                const totalDays = new Date(calYear, calMonth + 1, 0).getDate();
                const selectedDate = dateInput.value;

                const dayNames = ["S", "M", "T", "W", "T", "F", "S"];

                let html = dayNames
                    .map(day => `<div class="cal-day-name">${day}</div>`)
                    .join("");

                for (let i = 0; i < firstDay; i++) {
                    html += '<div class="cal-cell empty"></div>';
                }

                for (let day = 1; day <= totalDays; day++) {
                    const mm = String(calMonth + 1).padStart(2, "0");
                    const dd = String(day).padStart(2, "0");
                    const dateStr = `${calYear}-${mm}-${dd}`;

                    const isSelected = dateStr === selectedDate;
                    const isToday = dateStr === getLocalDateString(new Date());

                    const classes = [
                        "cal-cell",
                        isSelected ? "selected" : "",
                        isToday ? "today" : ""
                    ].filter(Boolean).join(" ");

                    html += `
                        <button type="button"
                                class="${classes}"
                                data-date="${dateStr}"
                                aria-pressed="${isSelected}">
                            ${day}
                        </button>`;
                }

                cells.innerHTML = html;
            }

            // Previous / Next month buttons
            window.changeRequestCalendarMonth = function (direction) {
                const nextMonth = new Date(
                    calYear,
                    calMonth + direction,
                    1
                );

                calYear = nextMonth.getFullYear();
                calMonth = nextMonth.getMonth();

                renderRequestCalendar();
            };

            // Select a date from the calendar
            cells.addEventListener("click", function (event) {
                const button = event.target.closest("button[data-date]");

                if (!button) return;

                dateInput.value = button.dataset.date;

                const parts = dateInput.value.split("-").map(Number);
                calYear = parts[0];
                calMonth = parts[1] - 1;

                dateInput.dispatchEvent(new Event("change", {
                    bubbles: true
                }));

                renderRequestCalendar();
            });

            // Also synchronize when the user changes the native date input.
            dateInput.addEventListener("change", function () {
                if (!this.value) return;

                const parts = this.value.split("-").map(Number);

                calYear = parts[0];
                calMonth = parts[1] - 1;

                renderRequestCalendar();
            });

            renderRequestCalendar();
        })();

    </script>
}