@model TestingSpareManagement.ViewModels.MasterConnectorViewModel

@{
    ViewData["Title"] = "Master Connector List";
}

<link rel="stylesheet"
      href="~/css/master-connector.css"
      asp-append-version="true" />


<div class="master-connector-page">

    <div class="page-title-bar">

        <div>

            <h2>
                📋 Master Connector List
            </h2>

            <span>
                Connector master data and inventory management
            </span>

        </div>


        <div class="record-count">

            <strong>
                @Model.TotalRecords
            </strong>

            Connectors

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">

            ✅ @TempData["SuccessMessage"]

        </div>
    }

    @if (TempData["EmailWarning"] != null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Email Notification:</strong>
            @TempData["EmailWarning"]
        </div>
    }

    <div class="master-layout">


        <div class="connector-form-card">

            <div class="section-title">

                <span>
                    ✚
                </span>

                <div>

                    <strong>
                        @(Model.Connector.Id > 0
                                                ? "Modify Master Connector"
                                                : "Add Master Connector")
                    </strong>

                    <small>
                        Enter connector information
                    </small>

                </div>

            </div>


            <form asp-controller="MasterConnector"
                  asp-action="@(Model.Connector.Id > 0 ? "Update" : "Save")"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Connector.Id" />

                <input type="hidden"
                       asp-for="CurrentPage" />

                <input type="hidden"
                       asp-for="PageSize" />


                <!-- Station -->

                <div class="form-group">

                    <label>
                        Testing Station Profile
                    </label>

                    <select asp-for="Connector.StationProfile"
                            class="form-control">

                        <option value="">
                            Select Station
                        </option>

                        <option value="OS">OS</option>
                        <option value="ATE">ATE</option>
                        <option value="APP">APP</option>
                        <option value="EUT">EUT</option>
                        <option value="FCT">FCT</option>

                    </select>

                    <span asp-validation-for="Connector.StationProfile"
                          class="validation-message">
                    </span>

                </div>


                <!-- Connector Code -->

                <div class="form-group">

                    <label>
                        Connector Code Type
                    </label>

                    <input asp-for="Connector.ConnectorCodeType"
                           class="form-control"
                           placeholder="e.g. C70, QT1, QT3" />

                    <span asp-validation-for="Connector.ConnectorCodeType"
                          class="validation-message">
                    </span>

                </div>


                <!-- Description -->

                <div class="form-group">

                    <label>
                        Description / Part No
                    </label>

                    <input asp-for="Connector.DescriptionPartNo"
                           class="form-control"
                           placeholder="e.g. Snoopy Board / 103PP-09940IA" />

                    <span asp-validation-for="Connector.DescriptionPartNo"
                          class="validation-message">
                    </span>

                </div>


                <!-- Photo -->

                <div class="form-group">

                    <label>
                        📷 Upload Connector Photo / Image
                    </label>

                    <input asp-for="PhotoFile"
                           type="file"
                           class="form-control"
                           accept="image/*"
                           onchange="previewConnectorImage(this)" />

                </div>


                <!-- Preview -->

                <div class="image-preview">

                    @if (!string.IsNullOrEmpty(Model.Connector.PhotoPath))
                    {
                        <img id="connectorImagePreview"
                             src="@Model.Connector.PhotoPath"
                             alt="Image Preview"
                             style="display:block;" />

                        <span id="previewText" style="display:none;">
                            🖼 Image Preview Box
                        </span>
                    }
                    else
                    {
                        <img id="connectorImagePreview"
                             src=""
                             alt="Image Preview"
                             style="display:none;" />

                        <span id="previewText">
                            🖼 Image Preview Box
                        </span>
                    }

                </div>


                <!-- Life Cycle -->

                <div class="form-group">

                    <label>
                        Life Cycles Limit
                    </label>

                    <input asp-for="Connector.LifeCycleLimit"
                           class="form-control"
                           placeholder="e.g. 4K, 2K, 5000" />

                </div>


                <!-- Base Stock -->

                <div class="form-group">

                    <label>
                        Total Base Stock (Pcs)
                    </label>

                    <input asp-for="Connector.BaseStock"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="Initial stock count" />

                </div>


                <!-- Alert -->

                <div class="form-group">

                    <label>
                        Alert Threshold Minimum
                    </label>

                    <input asp-for="Connector.AlertThreshold"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="Minimum stock" />

                </div>


                <!-- INR -->

                <div class="form-group">

                    <label>
                        Unit Cost Price (INR ₹)
                    </label>

                    <input asp-for="Connector.UnitCostINR"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Value in Indian Rupees" />

                </div>


                <!-- CNY -->

                <div class="form-group">

                    <label>
                        Unit Cost Price (CNY ¥)
                    </label>

                    <input asp-for="Connector.UnitCostCNY"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Value in Chinese Yuan" />

                </div>


                <button type="submit"
                        class="save-button">

                    @(Model.Connector.Id > 0
                                        ? "✏ Update Connector"
                                        : "💾 Save Connector Row")

                </button>


                @if (Model.Connector.Id > 0)
                {
                    <a href="@Url.Action("Index", "MasterConnector", new { pageNumber = Model.CurrentPage, pageSize = Model.PageSize })"
                       class="cancel-button"
                       style="text-decoration: none; display: block; text-align: center;">
                        ↩ Cancel Edit
                    </a>
                }
                else
                {
                    <button type="reset"
                            class="cancel-button">
                        ↩ Clear Form
                    </button>
                }

            </form>

        </div>


        <div class="connector-report-card">


            <div class="section-title report-title">

                <span>
                    📋
                </span>

                <div>

                    <strong>
                        Master Connector Inventory Matrix
                    </strong>

                    <small>
                        Live connector inventory report
                    </small>

                </div>

            </div>


            <div class="report-wrapper">

                <table class="connector-table">

                    <thead>

                        <tr>

                            <th>PHOTO</th>
                            <th>ASSET KEY</th>
                            <th>STATION</th>
                            <th>DESCRIPTION / PART NO</th>
                            <th>LIFE CYCLE</th>
                            <th>AVAILABLE STOCK</th>
                            <th>ALERT MIN</th>
                            <th>UNIT COST</th>
                            <th>STATUS</th>
                            <th>ACTIONS</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Connectors != null && Model.Connectors.Any())
                        {
                            foreach (var item in Model.Connectors)
                            {
                                <tr>

                                    <!-- PHOTO -->

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PhotoPath))
                                        {
                                            <img src="@item.PhotoPath"
                                                 class="connector-photo clickable-connector-photo"
                                                 alt="Connector Photo"
                                                 title="Click to view full image"
                                                 onclick="openConnectorImage(this.src, this.alt)"
                                                 style="cursor: zoom-in;"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="photo-placeholder">
                                                Photo
                                            </div>
                                        }
                            </td>


                            <!-- ASSET KEY -->

                            <td>

                                <strong class="asset-key">
                                    @item.StationProfile-@item.ConnectorCodeType
                                </strong>

                            </td>


                            <!-- STATION -->

                            <td>
                                @item.StationProfile
                            </td>


                            <!-- DESCRIPTION -->

                            <td>

                                <strong>
                                    @item.DescriptionPartNo
                                </strong>

                            </td>


                            <!-- LIFE CYCLE -->

                            <td>
                                @item.LifeCycleLimit
                            </td>


                            <!-- STOCK -->

                            <td>

                                <strong class="stock-value
                                                    @(item.StockStatus == "LOW STOCK"
                                                                                                ? "stock-low"
                                                                                                : "stock-safe")">

                                    @item.BaseStock

                                        </strong>

                                    </td>


                                    <!-- ALERT -->

                                    <td>
                                        @item.AlertThreshold
                                    </td>


                                    <!-- COST -->

                                    <td>

                                        <div class="cost-inr">
                                            ₹@item.UnitCostINR.ToString("N2")
                                        </div>

                                @if (item.UnitCostCNY.HasValue)
                                        {
                                            <div class="cost-cny">
                                                ¥@item.UnitCostCNY.Value.ToString("N2")
                                            </div>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.StockStatus == "LOW STOCK")
                                        {
                                            <span class="status-danger">
                                                ⚠ LOW
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-safe">
                                                ✓ SAFE
                                            </span>
                                        }

                                    </td>
                                    
                                    <!-- ACTIONS -->
                                    <td>
                                        <div class="action-buttons">

                                            <a href="@Url.Action("Edit", "MasterConnector",
                                                     new { id = item.Id,
                                                           pageNumber = Model.CurrentPage,
                                                           pageSize = Model.PageSize })"
                                               class="edit-button">
                                                <span class="action-icon edit-pencil" aria-hidden="true">✏</span>
                                                <span>Edit</span>
                                            </a>

                                            <button type="button"
                                                    class="delete-button"
                                                    onclick="deleteConnector(@item.Id)">
                                                <span class="action-icon">🗑</span>
                                                <span>Del</span>
                                            </button>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    class="empty-report">

                                    📋 No Master Connector records found.

                                    <br />

                                    Add your first connector using
                                    the form on the left.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
                <div id="connectorImageModal"
                     class="connector-image-modal"
                     onclick="closeConnectorImage(event)">

                    <button type="button"
                            class="connector-image-close"
                            onclick="hideConnectorImage()"
                            aria-label="Close image">
                        &times;
                    </button>

                    <div class="connector-image-container">
                        <img id="connectorImageLarge"
                             src=""
                             alt="Full Connector Image" />
                    </div>

                    <div class="connector-image-caption"
                         id="connectorImageCaption">
                        Connector Photo
                    </div>
                </div>
            </div>


            <!-- ================================================= -->
            <!-- PAGINATION -->
            <!-- ================================================= -->
            @if (Model.TotalPages > 1)
            {
                <div class="pagination-wrapper">

                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", "MasterConnector", new { pageNumber = Model.CurrentPage - 1, pageSize = Model.PageSize })"
                           class="page-btn">
                            ← Prev
                        </a>
                    }

                    <span class="page-info">
                        Page @Model.CurrentPage of @Model.TotalPages
                        (Total: @Model.TotalRecords records)
                    </span>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", "MasterConnector", new { pageNumber = Model.CurrentPage + 1, pageSize = Model.PageSize })"
                           class="page-btn">
                            Next →
                        </a>
                    }

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // =====================================================
        // IMAGE PREVIEW
        // =====================================================
        function previewConnectorImage(input) {

            const preview = document.getElementById("connectorImagePreview");
            const text = document.getElementById("previewText");

            if (input.files && input.files[0]) {

                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = "block";
                    if (text) text.style.display = "none";
                };

                reader.readAsDataURL(input.files[0]);
            }
        }


        // =====================================================
        // DELETE
        // =====================================================
        function deleteConnector(id) {

            if (!id || id <= 0) {
                alert('Invalid connector ID');
                return;
            }

            if (!confirm("Are you sure you want to delete this connector?")) {
                return;
            }

            const form = document.createElement("form");
            form.method = "POST";
            form.action = '@Url.Action("Delete", "MasterConnector")';

            const token = document.querySelector('input[name="__RequestVerificationToken"]');

            if (token) {
                const hiddenToken = document.createElement("input");
                hiddenToken.type = "hidden";
                hiddenToken.name = "__RequestVerificationToken";
                hiddenToken.value = token.value;
                form.appendChild(hiddenToken);
            }

            const idInput = document.createElement("input");
            idInput.type = "hidden";
            idInput.name = "id";
            idInput.value = id;
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }


        function openConnectorImage(imageUrl, imageAlt) {
            if (!imageUrl) {
                return;
            }

            const modal = document.getElementById("connectorImageModal");
            const largeImage = document.getElementById("connectorImageLarge");
            const caption = document.getElementById("connectorImageCaption");

            if (!modal || !largeImage) {
                return;
            }

            largeImage.src = imageUrl;
            largeImage.alt = imageAlt || "Connector Photo";

            if (caption) {
                caption.textContent = imageAlt || "Connector Photo";
            }

            modal.classList.add("active");
            document.body.classList.add("connector-image-modal-open");
        }

        function hideConnectorImage() {
            const modal = document.getElementById("connectorImageModal");
            const largeImage = document.getElementById("connectorImageLarge");

            if (modal) {
                modal.classList.remove("active");
            }

            document.body.classList.remove("connector-image-modal-open");

            if (largeImage) {
                largeImage.src = "";
            }
        }

        // Close when clicking the dark background
        function closeConnectorImage(event) {
            if (event.target.id === "connectorImageModal") {
                hideConnectorImage();
            }
        }

        // Close when pressing Escape
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                hideConnectorImage();
            }
        });
    </script>
}