                // =====================================================
        // YEARLY BUDGET - BULK SAVE (ALL ROWS AT ONCE)
        // =====================================================
        function saveYearlyBudgets() {
            const rows = document.querySelectorAll('.budget-master-table tbody tr');

            if (rows.length === 0) {
                alert('No budget rows to save.');
                return;
            }

            // అన్ని వరుసల డేటాను సేకరించండి
            const budgets = [];
            rows.forEach(row => {
                const year = row.querySelector('.budget-alloc').getAttribute('data-year');
                const alloc = row.querySelector('.budget-alloc').value || 0;
                const util = row.querySelector('.budget-util').value || 0;
                const saved = row.querySelector('.budget-saved').value || 0;

                budgets.push({
                    Year: parseInt(year),
                    AllocatedBudget: parseFloat(alloc),
                    BudgetUtilized: parseFloat(util),
                    CostSaved: parseFloat(saved)
                });
            });

            console.log('Saving budgets:', budgets); // Debug కోసం

            // Bulk save కోసం ఒక ఫారమ్ సృష్టించండి
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("SaveYearlyBudgetsBulk", "Profile")';
            form.style.display = 'none';

            // Anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const t = document.createElement('input');
                t.type = 'hidden';
                t.name = '__RequestVerificationToken';
                t.value = token.value;
                form.appendChild(t);
            }

            
            budgets.forEach((b, i) => {
                form.innerHTML += `<input type="hidden" name="budgets[${i}].Year" value="${b.Year}" />`;
                form.innerHTML += `<input type="hidden" name="budgets[${i}].AllocatedBudget" value="${b.AllocatedBudget}" />`;
                form.innerHTML += `<input type="hidden" name="budgets[${i}].BudgetUtilized" value="${b.BudgetUtilized}" />`;
                form.innerHTML += `<input type="hidden" name="budgets[${i}].CostSaved" value="${b.CostSaved}" />`;
            });

            document.body.appendChild(form);
            form.submit();
        }
        function addNewYear() {
            document.getElementById('newYearForm').style.display = 'block';
        }

        function cancelNewYear() {
            document.getElementById('newYearForm').style.display = 'none';
            document.getElementById('newYearInput').value = '';
        }

        function confirmNewYear() {
            const year = document.getElementById('newYearInput').value;

            if (!year || year < 2020 || year > 2100) {
                alert('Please enter a valid year (2020-2100).');
                return;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("SaveYearlyBudget", "Profile")';

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const t = document.createElement('input');
                t.type = 'hidden';
                t.name = '__RequestVerificationToken';
                t.value = token.value;
                form.appendChild(t);
            }

            form.innerHTML += `<input type="hidden" name="year" value="${year}" />`;
            form.innerHTML += `<input type="hidden" name="allocatedBudget" value="0" />`;
            form.innerHTML += `<input type="hidden" name="budgetUtilized" value="0" />`;
            form.innerHTML += `<input type="hidden" name="costSaved" value="0" />`;

            document.body.appendChild(form);
            form.submit();
        }

        // =====================================================
        // EDIT INFO MODAL
        // =====================================================
        function openEditInfoModal() {
            const modal = new bootstrap.Modal(document.getElementById('editInfoModal'));
            modal.show();
        }

        // =====================================================
        // AVATAR UPLOAD MODAL
        // =====================================================
        function openAvatarModal() {
            const preview = document.getElementById('avatarPreview');
            preview.src = '';
            preview.style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('avatarModal'));
            modal.show();
        }

        function previewAvatar(input) {
            const preview = document.getElementById('avatarPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'inline-block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
