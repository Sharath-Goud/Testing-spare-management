<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Testing Spare Management</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Dashboard CSS -->
    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TestingSpareManagement.styles.css"
          asp-append-version="true" />

    <!-- Icons -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- AI Global Brand & Link Engine -->
    <style>
        .header-search {
            cursor: text;
        }

        #aiGlobalSearch {
            width: 190px;
            min-width: 100px;
            border: 0;
            outline: 0;
            background: transparent;
            color: inherit;
        }

        #aiProductModal, #aiProductModal * {
            box-sizing: border-box;
        }

        #aiProductModal {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(15, 23, 42, .58);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            font-family: "Segoe UI", Arial, sans-serif;
        }

            #aiProductModal .ai-shell {
                width: min(1150px, 97vw);
                height: min(750px, 94vh);
                display: flex;
                overflow: hidden;
                background: #fdfbf7;
                border: 1px solid #e7dfd5;
                border-radius: 15px;
                box-shadow: 0 20px 55px rgba(0,0,0,.28);
            }

            #aiProductModal .ai-main {
                flex: 2;
                min-width: 0;
                display: flex;
                flex-direction: column;
                padding: 20px 25px;
                background: #fff;
                border-right: 1px solid #e7dfd5;
            }

            #aiProductModal .ai-heading {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding-bottom: 12px;
                border-bottom: 1px solid #e5e7eb;
                color: #10213d;
                font-size: 17px;
                font-weight: 800;
            }

            #aiProductModal .ai-close {
                flex: 0 0 36px;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                border: 1px solid #cbd5e1;
                background: #f1f5f9;
                cursor: pointer;
                color: #334155;
                font-size: 22px;
            }

            #aiProductModal .ai-chat {
                flex: 1;
                min-height: 0;
                overflow: auto;
                padding: 18px 0;
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            #aiProductModal .ai-user-message {
                align-self: flex-end;
                max-width: 85%;
                background: #f1f5f9;
                padding: 10px 16px;
                border-radius: 14px 14px 3px 14px;
                color: #334155;
                overflow-wrap: anywhere;
            }

            #aiProductModal .ai-answer {
                align-self: flex-start;
                width: min(100%, 650px);
                background: #f8fafc;
                border: 1px solid #dbe4ee;
                border-radius: 0 14px 14px 14px;
                padding: 17px;
                color: #1e293b;
                overflow-wrap: anywhere;
            }

            #aiProductModal .ai-analysis {
                display: flex;
                gap: 14px;
                align-items: flex-start;
                margin-bottom: 13px;
            }

            #aiProductModal .ai-cube {
                width: 80px;
                height: 80px;
                flex: 0 0 80px;
                display: grid;
                place-items: center;
                border: 1px solid #cbd5e1;
                border-radius: 10px;
                color: #0f766e;
                font-size: 34px;
            }

            #aiProductModal .ai-teal {
                color: #0f766e;
                font-weight: 800;
                margin: 0 0 7px;
            }

            #aiProductModal .ai-parameters {
                background: #f1f5f9;
                border-radius: 8px;
                padding: 12px;
                margin-bottom: 12px;
            }

                #aiProductModal .ai-parameters ul {
                    margin: 6px 0 0;
                    padding-left: 20px;
                    color: #475569;
                    line-height: 1.55;
                }

            #aiProductModal .ai-reasoning {
                background: #faf5ff;
                border-left: 3px solid #7c3aed;
                padding: 12px;
                border-radius: 5px;
                color: #475569;
                line-height: 1.5;
            }

            #aiProductModal .ai-composer {
                display: flex;
                gap: 10px;
                padding-top: 14px;
                border-top: 1px solid #e5e7eb;
            }

                #aiProductModal .ai-composer input {
                    flex: 1;
                    min-width: 0;
                    border: 1px solid #cbd5e1;
                    border-radius: 24px;
                    padding: 11px 17px;
                    outline: none;
                    background: white;
                }

            #aiProductModal .ai-send {
                width: 42px;
                height: 42px;
                flex: 0 0 42px;
                border: 0;
                border-radius: 50%;
                color: #fff;
                background: #0f766e;
                cursor: pointer;
                font-size: 18px;
            }

            #aiProductModal .ai-side {
                flex: 1;
                min-width: 260px;
                background: #fdfbf7;
                padding: 18px;
                display: flex;
                flex-direction: column;
                gap: 14px;
                overflow: auto;
            }

            #aiProductModal .ai-side-card {
                background: #fff;
                border: 1px solid #e7dfd5;
                border-radius: 10px;
                padding: 14px;
            }

            #aiProductModal .ai-side-title {
                display: block;
                font-weight: 800;
                color: #334155;
                margin-bottom: 10px;
            }

            #aiProductModal .ai-reference-box {
                background: #f8fafc;
                border: 1px solid #e5e7eb;
                border-radius: 6px;
                padding: 10px;
            }

                #aiProductModal .ai-reference-box a {
                    display: block;
                    margin: 0 0 10px;
                    color: #0f766e;
                    font-weight: 700;
                    overflow-wrap: anywhere;
                }

                    #aiProductModal .ai-reference-box a:last-child {
                        margin-bottom: 0;
                    }
        @@media(max - width:720px) {
            #aiProductModal .ai-shell

        {
            height: 95vh;
            overflow: auto;
            flex-direction: column;
        }

        #aiProductModal .ai-main {
            min-height: 470px;
            padding: 15px;
            border-right: 0;
        }

        #aiProductModal .ai-side {
            min-width: 0;
            overflow: visible;
        }

        #aiGlobalSearch {
            width: 125px;
        }

        #aiProductModal .ai-cube {
            width: 55px;
            height: 55px;
            flex-basis: 55px;
        }

        }
    </style>

</head>

<body>


    @{
        var userRole = Context.Session.GetString("Role")?.Trim() ?? "";

        var isAdmin = string.Equals(
        userRole,
        "Admin",
        StringComparison.OrdinalIgnoreCase);
    }

    <header class="app-header">

        <!-- Logo / Application Name -->
        <div class="header-brand">

            <!-- Company Logo -->
            <div class="company-logo">
                <img src="~/images/Foxlink-logo.png"
                     alt="Company Logo" />
            </div>

            <!-- Animated Gear -->
            <div class="brand-icon">
                <i class="fa-solid fa-gear"></i>
            </div>

            <div class="brand-text">

                <div class="brand-title">
                    Testing Spare Management
                </div>

                <div class="brand-subtitle">
                    INDUSTRY 4.0 SMART FACTORY AUTOMATION PLATFORM
                </div>

            </div>

        </div>


        <!-- Header Right Side -->
        <div class="header-right">

            <div class="header-search" title="Search a brand or part number with AI">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       id="aiGlobalSearch"
                       placeholder="Ask AI / search parts..."
                       autocomplete="off"
                       aria-label="Search a brand or part number" />
            </div>


            <div class="header-user">

                <div class="user-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div class="user-details">

                    <span class="user-label">

                    </span>

                    <span class="user-name">
                        @Context.Session.GetString("EmployeeName")
                    </span>

                </div>

            </div>


            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="logout-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="logout-button">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    Logout

                </button>

            </form>

        </div>

    </header>

    <div class="app-wrapper">

        <aside id="appSidebar"
               class="app-sidebar">


            <!-- Sidebar Header -->

            <div class="sidebar-header">

                <div class="sidebar-menu-icon"
                     onclick="toggleSidebarCollapse()">

                    <i class="fa-solid fa-bars"></i>

                </div>

                <span>
                    MAIN MENU
                </span>

            </div>

            <div class="sidebar-section">

                <div class="sidebar-section-title">
                    OPERATIONS
                </div>

                <button class="sidebar-item
           @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard"
                                                ? "active" : "")"
                        type="button"
                        data-title="Real-Time Command Center"
                        onclick="window.location.href='@Url.Action("Index", "Dashboard")'">

                    <span class="sidebar-icon sidebar-red">
                        <i class="fa-solid fa-bolt"></i>
                    </span>

                    <span class="sidebar-text">
                        Real-Time Command Center
                    </span>

                </button>


                <button class="sidebar-item
           @(ViewContext.RouteData.Values["controller"]?.ToString() == "MasterConnector"
                                                ? "active" : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("Index", "MasterConnector")'">

                    <span class="sidebar-icon sidebar-purple">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </span>

                    <span class="sidebar-text">
                        Master Connector List
                    </span>

                </button>

                <button class="sidebar-item
           @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consumption"
                                                                                                                                                                       ? "active"
                                                                                                                                                                       : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("DailyConsumption", "Consumption")'">

                    <span class="sidebar-icon sidebar-orange">
                        <i class="fa-solid fa-clock"></i>
                    </span>

                    <span class="sidebar-text">
                        Daily Consumption
                    </span>

                </button>


                <button class="sidebar-item
           @(ViewContext.RouteData.Values["controller"]?.ToString() == "MaterialRequest"
                                                                                                                                                                       ? "active"
                                                                                                                                                                       : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("Index", "MaterialRequest")'">

                    <span class="sidebar-icon sidebar-green">
                        <i class="fa-solid fa-file-pen"></i>
                    </span>

                    <span class="sidebar-text">
                        Material Request
                    </span>


                    @await Component.InvokeAsync("PendingMaterialRequests")


                </button>

            </div>


            <!-- ================================================= -->
            <!-- MANAGEMENT -->
            <!-- ================================================= -->

            <div class="sidebar-section">

                <div class="sidebar-section-title">
                    MANAGEMENT
                </div>


                <!-- ================================================= -->
                <!-- BUDGET & EXPENDITURE                               -->
                <!-- ================================================= -->
                @if (isAdmin)
                {
                    <button class="sidebar-item
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget"
                                                                    ? "active" : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("Index", "Budget")'">

                        <span class="sidebar-icon sidebar-purple">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>

                        <span class="sidebar-text">Budget &amp; Expenditure</span>
                    </button>
                                }



                <!-- ================================================= -->
                <!-- EQUIPMENT CONSUMABLES                              -->
                <!-- ================================================= -->

                <button class="sidebar-item
           @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipment"
                                                                                                                                                                       ? "active"
                                                                                                                                                                       : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("Index", "Equipment")'">

                    <span class="sidebar-icon sidebar-blue">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </span>

                    <span class="sidebar-text">
                        Equipment Consumables
                    </span>

                </button>


                <!-- ================================================= -->
                <!-- PR & PO TRACKER                                    -->
                <!-- ================================================= -->
                @if (isAdmin)
                {
                    <button class="sidebar-item admin-only
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "PrPoTracker"
                                                                                                                                                                                                       ? "active"
                                                                                                                                                                                                       : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("Index", "PrPoTracker")'">

                        <span class="sidebar-icon sidebar-red">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </span>

                        <span class="sidebar-text">
                            PR & PO Tracker
                        </span>

                    </button>
                                }
            </div>


            <div class="sidebar-section">

                @if (isAdmin)
                {
                    <div class="sidebar-section-title">
                        USER
                    </div>
                }


                @if (isAdmin)
                {
                    <button class="sidebar-item admin-only
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile"
                                                           ? "active"
                                                            : "")"
                        type="button"
                        onclick="window.location.href='@Url.Action("Index", "Profile")'">

                        <span class="sidebar-icon sidebar-purple">
                            <i class="fa-solid fa-user-gear"></i>
                        </span>

                        <span class="sidebar-text">
                            Profile & User Settings
                        </span>

                    </button>
                                }
            </div>


            <!-- ================================================= -->
            <!-- SIDEBAR FOOTER -->
            <!-- ================================================= -->

            <div class="sidebar-footer">

                <div class="system-status">

                    <span class="status-dot"></span>

                    <div>

                        <strong>
                            System Online
                        </strong>

                        <small>
                            All services operational
                        </small>

                    </div>

                </div>

            </div>

        </aside>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <main id="mainContent"
              class="app-main">

            @RenderBody()

        </main>

    </div>


    <!-- ========================================================= -->
    <!-- SCRIPTS -->
    <!-- ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/dashboard.js"
            asp-append-version="true"></script>


    <script>

        function openDashboardSection(sectionId, element) {

            if (sectionId === "sparesView") {

                window.location.href =
                    '@Url.Action("Index", "MasterConnector")';

                return;
            }


            const currentController =
                '@ViewContext.RouteData.Values["controller"]';


            if (
                currentController === "Dashboard" &&
                typeof switchDashboard === "function"
            ) {

                switchDashboard(
                    sectionId,
                    element
                );

                updateActiveSidebarItem(element);

                return;
            }


            const dashboardUrl =
                '@Url.Action("Index", "Dashboard")';

            window.location.href =
                dashboardUrl +
                "?section=" +
                encodeURIComponent(sectionId);

        }


        function updateActiveSidebarItem(element) {

            document
                .querySelectorAll(".sidebar-item")
                .forEach(function (item) {

                    item.classList.remove("active");

                });


            if (element) {

                element.classList.add("active");

            }

        }


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const currentController =
                    '@ViewContext.RouteData.Values["controller"]';


                // Only process the section when we are on Dashboard.

                if (currentController !== "Dashboard") {

                    return;

                }


                // Read ?section= from URL.

                const urlParams =
                    new URLSearchParams(
                        window.location.search
                    );


                const requestedSection =
                    urlParams.get("section");


                // No requested section.
                // Leave the normal Dashboard page as it is.

                if (!requestedSection) {

                    return;

                }


                // Wait until dashboard.js has loaded.

                if (
                    typeof switchDashboard === "function"
                ) {

                    openRequestedDashboardSection(
                        requestedSection
                    );

                    return;

                }


                // In case dashboard.js takes a moment to load,
                // try again shortly.

                setTimeout(
                    function () {

                        if (
                            typeof switchDashboard ===
                            "function"
                        ) {

                            openRequestedDashboardSection(
                                requestedSection
                            );

                        }

                    },
                    100
                );

            }
        );


        function openRequestedDashboardSection(
            sectionId
        ) {

            const sidebarItems =
                document.querySelectorAll(
                    ".sidebar-item"
                );


            let matchingElement = null;


            sidebarItems.forEach(
                function (item) {

                    const onclickValue =
                        item.getAttribute("onclick");


                    if (
                        onclickValue &&
                        onclickValue.indexOf(
                            "'" + sectionId + "'"
                        ) !== -1
                    ) {

                        matchingElement = item;

                    }

                }
            );


            switchDashboard(
                sectionId,
                matchingElement
            );

            updateActiveSidebarItem(
                matchingElement
            );

            const cleanUrl =
                window.location.pathname;


            window.history.replaceState(
                {},
                document.title,
                cleanUrl
            );

        }


        function toggleSidebar() {

            const sidebar =
                document.getElementById(
                    "appSidebar"
                );


            if (!sidebar) {

                return;

            }


            sidebar.classList.toggle(
                "mobile-open"
            );

        }

                // =====================================================
        // COLLAPSE / EXPAND SIDEBAR
        // =====================================================

        function toggleSidebarCollapse() {


            document.body.classList.toggle(
                "sidebar-collapsed"
            );


            // Save user preference

            const isCollapsed =
                document.body.classList.contains(
                    "sidebar-collapsed"
                );


            localStorage.setItem(
                "sidebarCollapsed",
                isCollapsed
            );

        }



        // =====================================================
        // LOAD SIDEBAR STATE
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                const collapsed =
                    localStorage.getItem(
                        "sidebarCollapsed"
                    );


                if (collapsed === "true") {


                    document.body.classList.add(
                        "sidebar-collapsed"
                    );


                }


            }
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    const sidebar =
                        document.getElementById(
                            "appSidebar"
                        );


                    if (
                        sidebar &&
                        sidebar.classList.contains(
                            "mobile-open"
                        )
                    ) {

                        sidebar.classList.remove(
                            "mobile-open"
                        );

                    }

                }

            }
        );

    </script>



    <!-- AI Global Brand & Link Engine behavior -->
    <script>
        (function () {
            "use strict";

            const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, ch => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
            }[ch]));

            function buildIntelligence(query) {
                const safeQuery = escapeHtml(query);
                const encoded = encodeURIComponent(query);
                const q = query.toLowerCase();
                let summary = `Global intelligence search for brand/part number <strong>"${safeQuery.toUpperCase()}"</strong>.`;
                let manufacturer = "Not yet verified";
                let category = "Industrial Automation & Spare Part";
                let verification = "Manufacturer website and datasheet search links";
                let reasoning = `Created targeted web-search links for "${safeQuery}". Open the references to verify the exact model, specification, and manufacturer.`;
                let icon = "⬡";

                if (q.includes("siemens")) {
                    manufacturer = "Siemens AG";
                    category = "Industrial Automation & SIMATIC Controllers";
                    verification = "Official Siemens automation/support search";
                    summary = `The search term <strong>"${safeQuery}"</strong> appears related to Siemens automation products. Confirm the exact model number in the official documentation.`;
                    icon = "⚙";
                } else if (q.includes("zebronics") || q.includes("scanner")) {
                    manufacturer = q.includes("zebronics") ? "Zebronics (verify exact model)" : "To be identified from the part number";
                    category = "Barcode Scanners / Peripherals (if applicable)";
                    verification = "Manufacturer product/support search";
                    summary = `Search results are prepared for <strong>"${safeQuery}"</strong>. Check the exact product model and interface before ordering.`;
                    icon = "▦";
                } else if (q.includes("java")) {
                    category = "Software / Java platform (confirm whether this is a part or brand search)";
                    verification = "Official Java website and technical documentation search";
                    summary = `Global intelligence search for <strong>"${safeQuery}"</strong>. The term can refer to Java software; confirm the intended brand or component.`;
                    icon = "◇";
                }

                const links = [
                    ["Official brand website search", `https://www.google.com/search?q=${encoded}+official+manufacturer+website`],
                    ["Technical datasheet (PDF) search", `https://www.google.com/search?q=${encoded}+datasheet+filetype%3Apdf`],
                    ["Global spare parts / product catalog", `https://www.google.com/search?q=${encoded}+spare+parts+catalog`],
                    ["Exact model and specifications", `https://www.google.com/search?q=${encoded}+model+specifications`]
                ];

                return { summary, manufacturer, category, verification, reasoning, icon, links };
            }

            function referenceLinks(links) {
                return links.map(link =>
                    `<a href="${link[1]}" target="_blank" rel="noopener noreferrer">• ${escapeHtml(link[0])} for "${escapeHtml(document.querySelector("#aiGlobalSearch")?.value.trim() || window.aiCurrentQuery || "")}"</a>`
                ).join("");
            }

            function openAiModal(query) {
                const existing = document.getElementById("aiProductModal");
                if (existing) existing.remove();
                window.aiCurrentQuery = query;

                const data = buildIntelligence(query);
                const modal = document.createElement("div");
                modal.id = "aiProductModal";
                modal.setAttribute("role", "dialog");
                modal.setAttribute("aria-modal", "true");
                modal.setAttribute("aria-label", "Gemini AI Global Brand and Link Engine");
                modal.innerHTML = `
                    <div class="ai-shell">
                        <section class="ai-main">
                            <div class="ai-heading">
                                <span>✨ Gemini AI Global Brand &amp; Link Engine</span>
                                <button type="button" class="ai-close" id="aiCloseModal" aria-label="Close">×</button>
                            </div>
                            <div class="ai-chat" id="aiChatScrollBody">
                                <div class="ai-user-message">${escapeHtml(query)}</div>
                                <div class="ai-answer">
                                    <div class="ai-analysis">
                                        <div class="ai-cube">${data.icon}</div>
                                        <div>
                                            <p class="ai-teal">🌐 Global Brand &amp; Model Analysis:</p>
                                            <div>${data.summary}</div>
                                        </div>
                                    </div>
                                    <div class="ai-parameters">
                                        <strong>Technical Parameters:</strong>
                                        <ul>
                                            <li><strong>Target Brand / Part:</strong> ${escapeHtml(query.toUpperCase())}</li>
                                            <li><strong>Manufacturer:</strong> ${escapeHtml(data.manufacturer)}</li>
                                            <li><strong>Component Category:</strong> ${escapeHtml(data.category)}</li>
                                            <li><strong>Verification:</strong> ${escapeHtml(data.verification)}</li>
                                        </ul>
                                    </div>
                                    <div class="ai-reasoning">
                                        <strong style="color:#7c3aed;display:block;margin-bottom:4px;">🧠 Deep Thinking &amp; Cross-Referencing:</strong>
                                        ${data.reasoning}
                                    </div>
                                </div>
                            </div>
                            <form class="ai-composer" id="aiFollowUpForm">
                                <input id="aiFollowUpInput" type="text" placeholder="Type another brand or part number..." autocomplete="off" aria-label="Search another brand or part number">
                                <button class="ai-send" type="submit" aria-label="Search">➤</button>
                            </form>
                        </section>
                        <aside class="ai-side">
                            <div class="ai-side-card">
                                <span class="ai-side-title">🔗 Official Brand Links &amp; Datasheets</span>
                                <div class="ai-reference-box" id="aiReferenceBox">
                                    ${data.links.map(link => `<a href="${link[1]}" target="_blank" rel="noopener noreferrer">• ${escapeHtml(link[0])} for "${escapeHtml(query)}"</a>`).join("")}
                                </div>
                            </div>
                            <div class="ai-side-card">
                                <span class="ai-side-title">▤ Live Industrial Bulletin</span>
                                <p style="font-size:13px;color:#64748b;line-height:1.5;margin:0">Use the official manufacturer links to validate the exact part number, datasheet, availability, and compatibility before purchasing.</p>
                            </div>
                        </aside>
                    </div>`;
                document.body.appendChild(modal);

                const close = () => modal.remove();
                document.getElementById("aiCloseModal").addEventListener("click", close);
                modal.addEventListener("click", event => { if (event.target === modal) close(); });

                document.getElementById("aiFollowUpForm").addEventListener("submit", event => {
                    event.preventDefault();
                    const input = document.getElementById("aiFollowUpInput");
                    const nextQuery = input.value.trim();
                    if (!nextQuery) return;
                    openAiModal(nextQuery);
                    const nextInput = document.getElementById("aiFollowUpInput");
                    if (nextInput) nextInput.focus();
                });
                document.addEventListener("keydown", function escapeHandler(event) {
                    if (event.key === "Escape" && document.getElementById("aiProductModal")) {
                        document.getElementById("aiProductModal").remove();
                        document.removeEventListener("keydown", escapeHandler);
                    }
                });
                document.getElementById("aiFollowUpInput").focus();
            }

            function submitSearch() {
                const input = document.getElementById("aiGlobalSearch");
                if (!input) return;
                const query = input.value.trim();
                if (!query) return;
                input.value = "";

                const lowerQuery = query.toLowerCase();
                if (/\b(pr|po|purchase)\b/.test(lowerQuery)) {
                    const prLink = Array.from(document.querySelectorAll("button, a"))
                        .find(el => (el.innerText || "").includes("PR & PO Tracker"));
                    if (prLink) {
                        prLink.click();
                        return;
                    }
                }
                openAiModal(query);
            }

            document.addEventListener("DOMContentLoaded", function () {
                const input = document.getElementById("aiGlobalSearch");
                if (!input) return;
                input.addEventListener("keydown", event => {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        submitSearch();
                    }
                });
                const wrapper = input.closest(".header-search");
                if (wrapper) {
                    wrapper.addEventListener("click", event => {
                        if (event.target !== input) input.focus();
                    });
                }
            });
        })();
    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>