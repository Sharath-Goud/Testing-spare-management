@model TestingSpareManagement.ViewModels.MasterConnectorViewModel

@{
    ViewData["Title"] = "Master Connector List";
}

<link rel="stylesheet"
      href="~/css/master-connector.css"
      asp-append-version="true" />


<div class="master-connector-page">

    <div class="page-title-bar">

        <div>

            <h2>
                📋 Master Connector List
            </h2>

            <span>
                Connector master data and inventory management
            </span>

        </div>


        <div class="record-count">

            <strong>
                @Model.TotalRecords
            </strong>

            Connectors

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">

            ✅ @TempData["SuccessMessage"]

        </div>
    }

    @if (TempData["EmailWarning"] != null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Email Notification:</strong>
            @TempData["EmailWarning"]
        </div>
    }

    <div class="master-layout">


        <div class="connector-form-card">

            <div class="section-title">

                <span>
                    ✚
                </span>

                <div>

                    <strong>
                        @(Model.Connector.Id > 0
                                                ? "Modify Master Connector"
                                                : "Add Master Connector")
                    </strong>

                    <small>
                        Enter connector information
                    </small>

                </div>

            </div>


            <form asp-controller="MasterConnector"
                  asp-action="@(Model.Connector.Id > 0 ? "Update" : "Save")"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Connector.Id" />

                <input type="hidden"
                       asp-for="CurrentPage" />

                <input type="hidden"
                       asp-for="PageSize" />


               <div class="form-group">
                    <label for="Connector_StationProfile">
                        Testing Station
                    </label>

                    <select asp-for="Connector.StationProfile"
                            asp-items="ViewBag.TestingStations"
                            class="form-control">

                        <option value="">Select Station</option>

                    </select>

                    <span asp-validation-for="Connector.StationProfile"
                          class="validation-message">
                    </span>
                </div>

                
                <!-- PROJECT -->
                <div class="form-group">
                    <label for="Connector_ProjectCode">Project</label>

                    <select asp-for="Connector.ProjectCode"
                            asp-items="Model.Projects"
                            class="form-control">
                        <option value="">Select Project</option>
                    </select>

                    <span asp-validation-for="Connector.ProjectCode"
                          class="validation-message"></span>
                </div>


                <!-- Connector Code -->

                @* <div class="form-group">

                    <label>
                        Connector Code Type
                    </label>

                    <input asp-for="Connector.ConnectorCodeType"
                           class="form-control"
                           placeholder="e.g. C70, QT1, QT3" />

                    <span asp-validation-for="Connector.ConnectorCodeType"
                          class="validation-message">
                    </span>

                </div> *@


                <div class="form-group">

                    <label>
                        Spare Item
                    </label>

                    <input asp-for="Connector.DescriptionPartNo"
                           class="form-control"
                           placeholder="Enter the spare Item" />

                    <span asp-validation-for="Connector.DescriptionPartNo"
                          class="validation-message">
                    </span>

                </div>


                <!-- Photo -->

                <div class="form-group">

                    <label>
                        📷 Upload Connector Photo / Image
                    </label>

                    <input asp-for="PhotoFile"
                           type="file"
                           class="form-control"
                           accept="image/*"
                           onchange="previewConnectorImage(this)" />

                </div>


                <!-- Preview -->

                <div class="image-preview">

                    @if (!string.IsNullOrEmpty(Model.Connector.PhotoPath))
                    {
                        <img id="connectorImagePreview"
                             src="@Model.Connector.PhotoPath"
                             alt="Image Preview"
                             style="display:block;" />

                        <span id="previewText" style="display:none;">
                            🖼 Image Preview Box
                        </span>
                    }
                    else
                    {
                        <img id="connectorImagePreview"
                             src=""
                             alt="Image Preview"
                             style="display:none;" />

                        <span id="previewText">
                            🖼 Image Preview Box
                        </span>
                    }

                </div>


                <!-- Life Cycle -->

                <div class="form-group">

                    <label>
                        Life Cycles Limit
                    </label>

                    <input asp-for="Connector.LifeCycleLimit"
                           class="form-control"
                           placeholder="e.g. 4K, 2K, 5000" />

                </div>


                <!-- Base Stock -->

                <div class="form-group">

                    <label>
                        Total Base Stock (Pcs)
                    </label>

                    <input asp-for="Connector.BaseStock"
                       type="number"
                       min="0"
                       value="@(Model.Connector.Id > 0 ? Model.Connector.BaseStock.ToString() : "")"
                       class="form-control"
                       placeholder="Initial stock count" />

                </div>


                <!-- Alert -->

                <div class="form-group">

                    <label>
                        Alert Threshold Minimum
                    </label>

                    <input asp-for="Connector.AlertThreshold"
                       type="number"
                       min="0"
                       value="@(Model.Connector.Id > 0 ? Model.Connector.AlertThreshold.ToString() : "")"
                       class="form-control"
                       placeholder="Minimum stock" />

                </div>


                <!-- INR -->

                <div class="form-group">

                    <label>
                        Unit Cost Price (INR ₹)
                    </label>

                    <input asp-for="Connector.UnitCostINR"
                       type="number"
                       id="unitCostINR"
                       step="0.01"
                       min="0"
                       value="@(Model.Connector.Id > 0 ? Model.Connector.UnitCostINR.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")"
                       class="form-control"
                       placeholder="Value in Indian Rupees" />

                </div>


                <!-- CNY -->

                <div class="form-group">

                    <label>
                        Unit Cost Price (CNY ¥)
                    </label>

                    <input asp-for="Connector.UnitCostCNY"
                        id="unitCostCNY"
                       type="number"
                       step="0.01"
                       min="0"
                       value="@(Model.Connector.Id > 0 && Model.Connector.UnitCostCNY.HasValue ? Model.Connector.UnitCostCNY.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")"
                       class="form-control"
                       placeholder="Value in Chinese Yuan" />

                </div>


                <button type="submit"
                        class="save-button">

                    @(Model.Connector.Id > 0
                                        ? "✏ Update Connector"
                                        : "💾 Save Connector Row")

                </button>


                @if (Model.Connector.Id > 0)
                {
                    <a href="@Url.Action("Index", "MasterConnector", new { pageNumber = Model.CurrentPage, pageSize = Model.PageSize })"
                       class="cancel-button"
                       style="text-decoration: none; display: block; text-align: center;">
                        ↩ Cancel Edit
                    </a>
                }
                else
                {
                    <button type="reset"
                            class="cancel-button">
                        ↩ Clear Form
                    </button>
                }

            </form>

        </div>


        <div class="connector-report-card">


            <div class="section-title report-title">

                <span>
                    📋
                </span>

                <div>

                    <strong>
                        Master Connector Inventory Matrix
                    </strong>

                    <small>
                        Live connector inventory report
                    </small>

                </div>

            </div>


            <div class="report-wrapper">

                <table class="connector-table">

                    <thead>

                        <tr>

                            <th>PHOTO</th>
                            <th>SPARE ITEM</th>
                            <th>STATION</th>
                            <th>PROJECT</th>
                            <th>LIFE CYCLE</th>
                            <th>AVAILABLE STOCK</th>
                            <th>ALERT MIN</th>
                            <th>UNIT COST</th>
                            <th>STATUS</th>
                            <th>ACTIONS</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Connectors != null && Model.Connectors.Any())
                        {
                            foreach (var item in Model.Connectors)
                            {
                                <tr>

                                    <!-- PHOTO -->

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PhotoPath))
                                        {
                                            <img src="@item.PhotoPath"
                                                 class="connector-photo clickable-connector-photo"
                                                 alt="Connector Photo"
                                                 title="Click to view full image"
                                                 onclick="openConnectorImage(this.src, this.alt)"
                                                 style="cursor: zoom-in;"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="photo-placeholder">
                                                Photo
                                            </div>
                                        }
                            </td>

                            <td>
                                <button type="button"
                                        class="connector-history-link"
                                        data-id="@item.Id"
                                        data-name="@item.DescriptionPartNo"
                                        data-project="@item.ProjectCode"
                                        data-station="@item.StationProfile"
                                        data-photo="@item.PhotoPath"
                                        data-lifecycle="@item.LifeCycleLimit"
                                        data-stock="@item.BaseStock"
                                        data-alert="@item.AlertThreshold"
                                        data-price="@item.UnitCostINR.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                        onclick="openConnectorPurchaseHistory(this)">
                                    @item.DescriptionPartNo
                                </button>
                            </td>
                            
                            <td>
                                @item.StationProfile
                            </td>

                            <td>
                                <strong class="asset-key">@item.ProjectCode</strong>
                            </td>
                          

                            <td>
                                @item.LifeCycleLimit
                            </td>

                            <td>

                                <strong class="stock-value
                                                    @(item.StockStatus == "LOW STOCK"
                                                                                                ? "stock-low"
                                                                                                : "stock-safe")">

                                    @item.BaseStock

                                        </strong>

                                    </td>

                                    <td>
                                        @item.AlertThreshold
                                    </td>

                                    <td>

                                        <div class="cost-inr">
                                            ₹@item.UnitCostINR.ToString("N2")
                                        </div>

                                @if (item.UnitCostCNY.HasValue)
                                        {
                                            <div class="cost-cny">
                                                ¥@item.UnitCostCNY.Value.ToString("N2")
                                            </div>
                                        }

                                    </td>

                                    <td>

                                        @if (item.StockStatus == "LOW STOCK")
                                        {
                                            <span class="status-danger">
                                                ⚠ LOW
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-safe">
                                                ✓ SAFE
                                            </span>
                                        }

                                    </td>
                                    
                                    <td>
                                        <div class="action-buttons">

                                            <a href="@Url.Action("Edit", "MasterConnector",
                                                     new { id = item.Id,
                                                           pageNumber = Model.CurrentPage,
                                                           pageSize = Model.PageSize })"
                                               class="edit-button">
                                                <span class="action-icon edit-pencil" aria-hidden="true">✏</span>
                                                <span>Edit</span>
                                            </a>

                                            <button type="button"
                                                    class="delete-button"
                                                    onclick="deleteConnector(@item.Id)">
                                                <span class="action-icon">🗑</span>
                                                <span>Del</span>
                                            </button>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    class="empty-report">

                                    📋 No Master Connector records found.

                                    <br />

                                    Add your first connector using
                                    the form on the left.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
                <div id="connectorImageModal"
                     class="connector-image-modal"
                     onclick="closeConnectorImage(event)">

                    <button type="button"
                            class="connector-image-close"
                            onclick="hideConnectorImage()"
                            aria-label="Close image">
                        &times;
                    </button>

                    <div class="connector-image-container">
                        <img id="connectorImageLarge"
                             src=""
                             alt="Full Connector Image" />
                    </div>

                    <div class="connector-image-caption"
                         id="connectorImageCaption">
                        Connector Photo
                    </div>
                </div>
            </div>


            <!-- ================================================= -->
            <!-- PAGINATION -->
            <!-- ================================================= -->
            @if (Model.TotalPages > 1)
            {
                <div class="pagination-wrapper">

                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", "MasterConnector", new { pageNumber = Model.CurrentPage - 1, pageSize = Model.PageSize })"
                           class="page-btn">
                            ← Prev
                        </a>
                    }

                    <span class="page-info">
                        Page @Model.CurrentPage of @Model.TotalPages
                        (Total: @Model.TotalRecords records)
                    </span>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", "MasterConnector", new { pageNumber = Model.CurrentPage + 1, pageSize = Model.PageSize })"
                           class="page-btn">
                            Next →
                        </a>
                    }

                </div>
            }

        </div>
        
<!-- MASTER CONNECTOR PURCHASE HISTORY MODAL -->
<div id="connectorPurchaseHistoryModal"
     class="purchase-history-modal"
     aria-hidden="true">

    <div class="purchase-history-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="connectorHistoryTitle">

        <div class="purchase-history-header">
            <h3 id="connectorHistoryTitle">
                📦 <span id="mcHistoryTitle">Purchase History</span>
            </h3>

            <button type="button"
                    class="purchase-history-close"
                    onclick="closeConnectorPurchaseHistory()"
                    aria-label="Close">
                &times;
            </button>
        </div>

        <div class="purchase-history-content">

            <section class="purchase-history-details">

                <div class="history-product-card">
                    <div class="history-product-photo">
                        <img id="mcHistoryPhoto"
                             src=""
                             alt="Connector photo"
                             hidden />
                        <span id="mcHistoryPhotoPlaceholder">No Image</span>
                    </div>

                    <div class="history-product-info">
                        <span class="history-eyebrow">MASTER CONNECTOR</span>
                        <h4 id="mcHistoryName">—</h4>
                    </div>
                </div>

                <div class="history-specifications">
                    <h4>📊 Technical Specifications &amp; Parameters:</h4>
                    <ul>
                        <li><strong>Testing Station:</strong> <span id="mcHistoryStation">—</span></li>
                        <li><strong>Project Code:</strong> <span id="mcHistoryProject">—</span></li>
                        <li><strong>Life Cycle Limit:</strong> <span id="mcHistoryLifecycle">—</span></li>
                        <li><strong>Unit Cost:</strong> <span id="mcHistoryPrice">—</span></li>
                        <li><strong>Available Stock:</strong> <span id="mcHistoryStock">—</span></li>
                        <li><strong>Alert Threshold:</strong> <span id="mcHistoryAlert">—</span></li>
                    </ul>
                </div>

                <div class="history-tracking-note">
                    <h4>💡 Deep Tracking Note:</h4>
                    <p>Previous purchase records associated with this connector are displayed on the right.</p>
                </div>

            </section>

            <section class="purchase-history-records">
                <h4>📋 Previous Purchase Records</h4>

                <div class="history-table-wrapper">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>DATE</th>
                                <th>PR NO</th>
                                <th>QTY</th>
                                <th>TOTAL COST</th>
                                <th>STATUS</th>
                            </tr>
                        </thead>
                        <tbody id="mcPurchaseHistoryRows">
                            <tr>
                                <td colspan="5" class="history-message">
                                    Select an item to load purchase history.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

        </div>
    </div>
</div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // =====================================================
        // IMAGE PREVIEW
        // =====================================================
        function previewConnectorImage(input) {

            const preview = document.getElementById("connectorImagePreview");
            const text = document.getElementById("previewText");

            if (input.files && input.files[0]) {

                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = "block";
                    if (text) text.style.display = "none";
                };

                reader.readAsDataURL(input.files[0]);
            }
        }


        // =====================================================
        // DELETE
        // =====================================================
        function deleteConnector(id) {

            if (!id || id <= 0) {
                alert('Invalid connector ID');
                return;
            }

            if (!confirm("Are you sure you want to delete this connector?")) {
                return;
            }

            const form = document.createElement("form");
            form.method = "POST";
            form.action = '@Url.Action("Delete", "MasterConnector")';

            const token = document.querySelector('input[name="__RequestVerificationToken"]');

            if (token) {
                const hiddenToken = document.createElement("input");
                hiddenToken.type = "hidden";
                hiddenToken.name = "__RequestVerificationToken";
                hiddenToken.value = token.value;
                form.appendChild(hiddenToken);
            }

            const idInput = document.createElement("input");
            idInput.type = "hidden";
            idInput.name = "id";
            idInput.value = id;
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }


        function openConnectorImage(imageUrl, imageAlt) {
            if (!imageUrl) {
                return;
            }

            const modal = document.getElementById("connectorImageModal");
            const largeImage = document.getElementById("connectorImageLarge");
            const caption = document.getElementById("connectorImageCaption");

            if (!modal || !largeImage) {
                return;
            }

            largeImage.src = imageUrl;
            largeImage.alt = imageAlt || "Connector Photo";

            if (caption) {
                caption.textContent = imageAlt || "Connector Photo";
            }

            modal.classList.add("active");
            document.body.classList.add("connector-image-modal-open");
        }
            
        function hideConnectorImage() {
            const modal = document.getElementById("connectorImageModal");
            const largeImage = document.getElementById("connectorImageLarge");

            if (modal) {
                modal.classList.remove("active");
            }

            document.body.classList.remove("connector-image-modal-open");

            if (largeImage) {
                largeImage.src = "";
            }
        }

        // Close when clicking the dark background
        function closeConnectorImage(event) {
            if (event.target.id === "connectorImageModal") {
                hideConnectorImage();
            }
        }

        // Close when pressing Escape
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                hideConnectorImage();
            }
        });

        
 // =====================================================
 // AUTOMATIC INR TO RMB (CNY) CONVERSION
 // Uses the latest available exchange rate
 // =====================================================
 document.addEventListener("DOMContentLoaded", async function () {

     const inrInput = document.getElementById("unitCostINR");
     const cnyInput = document.getElementById("unitCostCNY");

     if (!inrInput || !cnyInput) {
         return;
     }

     let conversionRate = null;

     async function loadExchangeRate() {
         try {
             const response = await fetch(
                 "https://open.er-api.com/v6/latest/INR",
                 { cache: "no-store" }
             );

             if (!response.ok) {
                 throw new Error("Exchange rate request failed.");
             }

             const data = await response.json();

             if (
                 data.result !== "success" ||
                 !data.rates ||
                 !Number.isFinite(data.rates.CNY) ||
                 data.rates.CNY <= 0
             ) {
                 throw new Error("Invalid INR to CNY rate.");
             }

             conversionRate = data.rates.CNY;

             // Calculate immediately using the retrieved rate.
             convertINRtoCNY();

             console.log(
                 "INR to CNY rate:",
                 conversionRate,
                 "Rate date:",
                 data.time_last_update_utc || "Not provided"
             );

         } catch (error) {
             console.error("Unable to retrieve exchange rate:", error);
             alert(
                 "Unable to retrieve the latest INR to CNY exchange rate. " +
                 "Please try again before saving."
             );
         }
     }

     function convertINRtoCNY() {

         if (conversionRate === null) {
             return;
         }

         const inrValue = Number(inrInput.value);

         if (
             inrInput.value.trim() === "" ||
             !Number.isFinite(inrValue) ||
             inrValue < 0
         ) {
             cnyInput.value = "";
             return;
         }

         cnyInput.value = (inrValue * conversionRate).toFixed(2);

         cnyInput.dispatchEvent(
             new Event("input", { bubbles: true })
         );

         cnyInput.dispatchEvent(
             new Event("change", { bubbles: true })
         );
     }

     inrInput.addEventListener("input", convertINRtoCNY);

     // Fetch the latest available rate when the page opens.
     await loadExchangeRate();
 });

 
async function openConnectorPurchaseHistory(button) {
    const modal = document.getElementById("connectorPurchaseHistoryModal");
    const rows = document.getElementById("mcPurchaseHistoryRows");
    const photo = document.getElementById("mcHistoryPhoto");
    const placeholder = document.getElementById("mcHistoryPhotoPlaceholder");

    const name = button.dataset.name || "Purchase History";

    document.getElementById("mcHistoryTitle").textContent = name;
    document.getElementById("mcHistoryName").textContent = name;
    document.getElementById("mcHistoryStation").textContent = button.dataset.station || "—";
    document.getElementById("mcHistoryProject").textContent = button.dataset.project || "—";
    document.getElementById("mcHistoryLifecycle").textContent = button.dataset.lifecycle || "—";
    document.getElementById("mcHistoryPrice").textContent = "₹" + (button.dataset.price || "0.00");
    document.getElementById("mcHistoryStock").textContent = (button.dataset.stock || "0") + " Pcs";
    document.getElementById("mcHistoryAlert").textContent = (button.dataset.alert || "0") + " Pcs";

    photo.onerror = () => {
        photo.hidden = true;
        photo.removeAttribute("src");
        placeholder.hidden = false;
    };

    if (button.dataset.photo) {
        photo.src = button.dataset.photo;
        photo.hidden = false;
        placeholder.hidden = true;
    } else {
        photo.hidden = true;
        photo.removeAttribute("src");
        placeholder.hidden = false;
    }

    modal.classList.add("active");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("purchase-history-open");

    rows.replaceChildren();

    const loadingRow = document.createElement("tr");
    const loadingCell = document.createElement("td");
    loadingCell.colSpan = 5;
    loadingCell.className = "history-message";
    loadingCell.textContent = "Loading purchase history...";
    loadingRow.appendChild(loadingCell);
    rows.appendChild(loadingRow);

    try {
        const response = await fetch(
            '@Url.Action("PurchaseHistory", "MasterConnector")?id=' +
            encodeURIComponent(button.dataset.id),
            { headers: { "Accept": "application/json" } }
        );

        if (!response.ok) {
            throw new Error("Unable to retrieve purchase history.");
        }

        const records = await response.json();

        // Do not populate a modal that has already been closed.
        if (!modal.classList.contains("active")) return;

        rows.replaceChildren();

        if (!Array.isArray(records) || records.length === 0) {
            showConnectorHistoryMessage(rows, "No previous purchase records found.");
            return;
        }

        records.forEach(record => {
            const tr = document.createElement("tr");

            [
                record.date,
                record.prNo,
                record.quantity,
                record.totalCost,
                record.status
            ].forEach(value => {
                const td = document.createElement("td");
                td.textContent = value ?? "—";
                tr.appendChild(td);
            });

            rows.appendChild(tr);
        });
    } catch (error) {
        console.error("Connector purchase history error:", error);
        rows.replaceChildren();
        showConnectorHistoryMessage(
            rows,
            "Purchase history could not be loaded. Please check the server endpoint."
        );
    }
}


function showConnectorHistoryMessage(tbody, message) {
    const tr = document.createElement("tr");
    const td = document.createElement("td");

    td.colSpan = 5;
    td.className = "history-message";
    td.innerHTML = `
        <div class="history-empty-state">
            <div class="history-empty-icon">📋</div>
            <div class="history-empty-title">No Purchase Records</div>
            <div class="history-empty-description"></div>
        </div>
    `;

    td.querySelector(".history-empty-description").textContent = message;

    tr.appendChild(td);
    tbody.appendChild(tr);
}


function closeConnectorPurchaseHistory() {
    const modal = document.getElementById("connectorPurchaseHistoryModal");
    modal.classList.remove("active");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("purchase-history-open");
}

document.getElementById("connectorPurchaseHistoryModal")
    .addEventListener("click", function (event) {
        if (event.target === this) {
            closeConnectorPurchaseHistory();
        }
    });

document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") {
        closeConnectorPurchaseHistory();
    }
});


    </script>
}