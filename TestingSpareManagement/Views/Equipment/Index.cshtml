@model TestingSpareManagement.Models.EquipmentConsumableViewModel

@{
    ViewData["Title"] = "Equipment Consumables";
}

<link rel="stylesheet"
      href="~/css/equipment-consumables.css"
      asp-append-version="true" />

<div class="equipment-page-wrapper">

    <div class="equipment-form-panel">
        <h5><i class="fa-solid fa-plus-circle"></i> Link Spare / Add Requirement</h5>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="font-size: 0.8rem; padding: 8px;">
                ✅ @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="font-size: 0.8rem; padding: 8px;">
                ⚠ @TempData["ErrorMessage"]
            </div>
        }

        <form asp-controller="Equipment" asp-action="Save" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label><i class="fa-solid fa-folder"></i> Target Project Code</label>
                <select asp-for="ProjectCode" class="form-control-custom">
                    <option value="A246f">A246f</option>
                    <option value="A246c">A246c</option>
                    <option value="Vivo_zv6">Vivo_zv6</option>
                </select>
            </div>


            <div class="form-group">
                <label for="TestItemName">
                    <i class="fa-solid fa-microchip"></i>
                    Spare Item
                </label>

                <input asp-for="TestItemName"
                       id="TestItemName"
                       type="text"
                       class="form-control-custom"
                       placeholder="Enter Spare Item Name" />

                <span asp-validation-for="TestItemName"
                      class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label>Target Test Equipment Station</label>

                <select asp-for="TargetStation"
                        class="form-control-custom">

                    <option value="">-- Select Testing Station --</option>

                    @foreach (var station in Model.TestingStations)
                    {
                        <option value="@station">@station</option>
                    }
                </select>

                <span asp-validation-for="TargetStation"
                      class="text-danger small"></span>
            </div>


            <div class="form-group">
                <label><i class="fa-solid fa-boxes-stacked"></i> Spare Bin / Storage Location</label>
                <input asp-for="StorageLocation" class="form-control-custom" placeholder="e.g. RACK-1 BIN-3" />
                <span asp-validation-for="StorageLocation" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label><i class="fa-solid fa-triangle-exclamation"></i> Alert Threshold Minimum (Sets Limit)</label>
                <input asp-for="AlertThresholdMin"
                       type="number"
                       class="form-control-custom"
                       placeholder="e.g. 5"
                       value="@(Model.AlertThresholdMin == 0 ? "" : Model.AlertThresholdMin.ToString())" />
                <span asp-validation-for="AlertThresholdMin" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label><i class="fa-solid fa-cubes"></i> Available Quantity (Sets)</label>
                <input asp-for="AvailableQuantity"
                       type="number"
                       class="form-control-custom"
                       placeholder="e.g. 10"
                       value="@(Model.AvailableQuantity == 0 ? "" : Model.AvailableQuantity.ToString())" />
                <span asp-validation-for="AvailableQuantity" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label><i class="fa-solid fa-indian-rupee-sign"></i> Unit Price (INR ₹)</label>
                <input asp-for="UnitPriceINR"
                       type="number"
                       step="0.01"
                       class="form-control-custom"
                       placeholder="e.g. 1500.00"
                       value="@(Model.UnitPriceINR == 0 ? "" : Model.UnitPriceINR.ToString())" />
                <span asp-validation-for="UnitPriceINR" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label>Specification Cycles Limit</label>
                <input asp-for="SpecCyclesLimit" type="number" class="form-control-custom" placeholder="e.g. 485" />
            </div>

            <div class="form-group">
                <label><i class="fa-solid fa-camera"></i> Upload Equipment Spare Photo</label>
                <input asp-for="PhotoFile" type="file" class="form-control-custom" accept="image/*" onchange="previewImage(this)" />
            </div>

            <div class="image-preview-box" id="imagePreviewBox">
                <div class="preview-placeholder" id="previewPlaceholder">
                    <i class="fa-solid fa-image"></i>
                    <span>🖼 Image Preview Box</span>
                </div>
                <img id="previewImg" src="" style="display:none;" alt="Preview" />
            </div>

            <button type="submit" class="btn-save-equipment" style="margin-top: 15px;">
                Save Equipment Consumable
            </button>
            <button type="reset" class="btn-cancel-equipment" onclick="resetPreview()">
                Cancel Modification
            </button>
        </form>
    </div>

    <div class="equipment-matrix-panel">

        <div class="matrix-header">
            <h5><i class="fa-solid fa-toolbox"></i> Equipment Consumables Matrix</h5>
            <div style="display: flex; gap: 10px;">
                <button type="button" onclick="exportToExcel()"
                        style="background-color: #217346; color: white; padding: 6px 15px; border: none; border-radius: 4px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
                    <i class="fa-solid fa-file-excel"></i> Export Excel
                </button>
                <button type="button" onclick="exportToPdf()"
                        style="background-color: #c82333; color: white; padding: 6px 15px; border: none; border-radius: 4px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
                    <i class="fa-solid fa-file-pdf"></i> Export PDF
                </button>
            </div>
        </div>

        <div class="matrix-search">
            <div class="matrix-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="matrixSearchInput" placeholder="Type Test Item Name, Project, Equipment, or Location to search..." />
            </div>
        </div>

        <div class="matrix-table-container">
            <table class="matrix-table" id="equipmentTable">
                <thead>
                    <tr>
                        <th>PHOTO</th>
                        <th>SPARE ITEM</th>
                        <th>PROJECT</th>
                        <th>STATION</th>
                        <th>STORAGE LOCATION</th>
                        <th>AVAILABLE QTY</th>
                        <th>ALERT MIN</th>
                        <th>UNIT PRICE (INR / RMB)</th>
                        <th>SPEC. CYCLES</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Equipments != null && Model.Equipments.Any())
                    {
                        foreach (var item in Model.Equipments)
                        {
                            <tr>
                                <td>
                                    <div class="photo-thumb">
                                        @if (!string.IsNullOrEmpty(item.PhotoPath))
                                        {
                                            <img src="@item.PhotoPath"
                                                 alt="Equipment Spare Photo"
                                                 class="clickable-equipment-photo"
                                                 title="Click to view full image"
                                                 onclick="openEquipmentImage(this.src, this.alt)"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <span>Photo</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <button type="button"
                                            class="equipment-history-link"
                                            data-id="@item.Id"
                                            data-name="@item.TestItemName"
                                            data-project="@item.ProjectCode"
                                            data-equipment="@item.AssignedEquipment"
                                            data-location="@item.StorageLocation"
                                            data-price="@item.UnitPriceINR.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-quantity="@item.AvailableQuantity"
                                            data-cycles="@item.SpecCycles"
                                            data-photo="@item.PhotoPath"
                                            onclick="openPurchaseHistory(this)">
                                        @item.TestItemName
                                    </button>
                                </td>
                                <td><span class="project-code">@item.ProjectCode</span></td>
                                <td>@item.AssignedEquipment</td>
                                <td><span class="storage-location">@item.StorageLocation</span></td>
                                <td><span class="available-qty">@item.AvailableQuantity Sets</span></td>
                                <td>@item.AlertThreshold Sets</td>
                                <td>
                                    <span class="unit-price-inr">₹@item.UnitPriceINR.ToString("N2")</span>
                                    <span class="unit-price-rmb">¥@item.UnitPriceRMB.ToString("N2")</span>
                                </td>
                                <td>@item.SpecCycles</td>
                                <td>
                                    @if (item.Status == "LOW STOCK")
                                    {
                                        <span class="status-pill-low">⚠ LOW<br />STOCK</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill-safe">✓ SAFE</span>
                                    }
                                </td>
                                <td>
                                    <div class="matrix-actions">
                                        <button type="button" class="btn-matrix-edit" onclick="openEditModal(@item.Id)">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </button>
                                        <button type="button" class="btn-matrix-del" onclick="deleteEquipment(@item.Id)">
                                            <i class="fa-solid fa-trash"></i> Del
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11">
                                <div class="matrix-empty">
                                    <i class="fa-solid fa-inbox"></i>
                                    No equipment consumables found.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="equipmentImageModal"
                 class="equipment-image-modal"
                 onclick="closeEquipmentImage(event)">

                <button type="button"
                        class="equipment-image-close"
                        onclick="hideEquipmentImage()"
                        aria-label="Close image">
                    &times;
                </button>

                <div class="equipment-image-container">
                    <img id="equipmentImageLarge"
                         src=""
                         alt="Equipment Spare Photo" />
                </div>

                <div id="equipmentImageCaption"
                     class="equipment-image-caption">
                    Equipment Spare Photo
                </div>
            </div>
        </div>


        <!-- PURCHASE HISTORY MODAL -->
        <div id="purchaseHistoryModal"
             class="purchase-history-modal"
             aria-hidden="true">

            <div class="purchase-history-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="purchaseHistoryTitle">

                <div class="purchase-history-header">
                    <h3 id="purchaseHistoryTitle">
                        <span>📦</span>
                        <span id="historyItemTitle">Purchase History</span>
                    </h3>

                    <button type="button"
                            class="purchase-history-close"
                            onclick="closePurchaseHistory()"
                            aria-label="Close">
                        &times;
                    </button>
                </div>

                <div class="purchase-history-content">

                    <!-- LEFT: ITEM DETAILS -->
                    <section class="purchase-history-details">

                        <div class="history-product-card">
                            <div class="history-product-photo">
                                <img id="historyItemPhoto"
                                     src=""
                                     alt="Equipment"
                                     hidden />

                                <span id="historyPhotoPlaceholder">
                                    No Image
                                </span>
                            </div>

                            <div class="history-product-info">
                                <span class="history-eyebrow">
                                    TARGET CONSUMABLE
                                </span>

                                <h4 id="historyItemName">—</h4>
                            </div>
                        </div>

                        <div class="history-specifications">
                            <h4>📊 Technical Specifications &amp; Parameters:</h4>

                            <ul>
                                <li>
                                    <strong>Assigned Equipment:</strong>
                                    <span id="historyEquipment">—</span>
                                </li>
                                <li>
                                    <strong>Project Code:</strong>
                                    <span id="historyProject">—</span>
                                </li>
                                <li>
                                    <strong>Storage Location:</strong>
                                    <span id="historyLocation">—</span>
                                </li>
                                <li>
                                    <strong>Unit Cost:</strong>
                                    <span id="historyPrice">—</span>
                                </li>
                                <li>
                                    <strong>Available Quantity:</strong>
                                    <span id="historyQuantity">—</span>
                                </li>
                                <li>
                                    <strong>Specification Cycles:</strong>
                                    <span id="historyCycles">—</span>
                                </li>
                            </ul>
                        </div>

                        <div class="history-tracking-note">
                            <h4>💡 Deep Tracking Note:</h4>
                            <p>
                                Previous purchase records associated with
                                this test item are displayed on the right.
                            </p>
                        </div>

                    </section>

                    <!-- RIGHT: PURCHASE HISTORY -->
                    <section class="purchase-history-records">
                        <h4>📋 Previous Purchase Records</h4>

                        <div class="history-table-wrapper">
                            <table class="history-table">
                                <thead>
                                    <tr>
                                        <th>DATE</th>
                                        <th>PR NO</th>
                                        <th>QTY</th>
                                        <th>TOTAL COST</th>
                                        <th>STATUS</th>
                                    </tr>
                                </thead>

                                <tbody id="purchaseHistoryRows">
                                    <tr>
                                        <td colspan="5" class="history-message">
                                            Select an item to load purchase history.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                </div>
            </div>
        </div>

    </div>

</div>


<div class="modal fade" id="editEquipmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Equipment" asp-action="Update" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" id="editId" />

                <div class="modal-header">
                    <h5 class="modal-title">✏ Edit Equipment Consumable</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Target Project Code</label>
                                <select name="ProjectCode" id="editProjectCode" class="form-control-custom">
                                    <option value="A246f">A246f</option>
                                    <option value="A246c">A246c</option>
                                    <option value="Vivo_zv6">Vivo_zv6</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Test Item / Requirement Name</label>
                                <input type="text" name="TestItemName" id="editTestItemName" class="form-control-custom" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Testing Station</label>
                                <select name="TargetStation"
                                        id="editTargetStation"
                                        class="form-control-custom">

                                    <option value="">-- Select Testing Station --</option>

                                    @foreach (var station in Model.TestingStations)
                                    {
                                        <option value="@station">@station</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Storage Location</label>
                                <input type="text" name="StorageLocation" id="editStorageLocation" class="form-control-custom" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Alert Threshold Min</label>
                                <input type="number" name="AlertThresholdMin" id="editAlertThreshold" class="form-control-custom" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Available Quantity</label>
                                <input type="number" name="AvailableQuantity" id="editAvailableQuantity" class="form-control-custom" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Spec Cycles Limit</label>
                                <input type="number" name="SpecCyclesLimit" id="editSpecCycles" class="form-control-custom" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Unit Price (INR ₹)</label>
                                <input type="number" step="0.01" name="UnitPriceINR" id="editUnitPrice" class="form-control-custom" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Replace Photo (Optional)</label>
                                <input type="file" name="PhotoFile" accept="image/*" class="form-control-custom" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        
        function previewImage(input) {
            const preview = document.getElementById('previewImg');
            const placeholder = document.getElementById('previewPlaceholder');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function resetPreview() {
            const preview = document.getElementById('previewImg');
            const placeholder = document.getElementById('previewPlaceholder');
            preview.style.display = 'none';
            preview.src = '';
            placeholder.style.display = 'flex';
        }

        document.getElementById('matrixSearchInput').addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll('#equipmentTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });

        function openEditModal(id) {
            fetch('@Url.Action("Edit", "Equipment")/' + id)
                .then(response => {
                    if (!response.ok) throw new Error('Failed to load equipment');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('editId').value = data.id;
                    document.getElementById('editProjectCode').value = data.projectCode;
                    document.getElementById('editTestItemName').value = data.testItemName;
                    document.getElementById('editTargetStation').value = data.assignedEquipment;
                    document.getElementById('editStorageLocation').value = data.storageLocation;
                    document.getElementById('editAvailableQuantity').value = data.availableQuantity;
                    document.getElementById('editAlertThreshold').value = data.alertThreshold;
                    document.getElementById('editUnitPrice').value = data.unitPriceINR;
                    document.getElementById('editSpecCycles').value = data.specCycles;

                    const modal = new bootstrap.Modal(document.getElementById('editEquipmentModal'));
                    modal.show();
                })
                .catch(err => {
                    alert('Error loading equipment: ' + err.message);
                });
        }

        function deleteEquipment(id) {
            if (!confirm('Are you sure you want to delete this equipment?')) return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete", "Equipment")';

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const hiddenToken = document.createElement('input');
                hiddenToken.type = 'hidden';
                hiddenToken.name = '__RequestVerificationToken';
                hiddenToken.value = token.value;
                form.appendChild(hiddenToken);
            }

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = id;
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }

        function exportToExcel() {
            const table = document.getElementById('equipmentTable');
            const dataRows = table.querySelectorAll('tbody tr');

            if (dataRows.length === 0 || (dataRows.length === 1 && dataRows[0].querySelector('.matrix-empty'))) {
                alert('No data to export.');
                return;
            }

            const headers = ['PROJECT', 'TEST ITEM', 'ASSIGNED EQUIPMENT',
                'STORAGE LOCATION', 'AVAILABLE QTY', 'ALERT MIN',
                'UNIT PRICE INR', 'UNIT PRICE RMB', 'SPEC CYCLES', 'STATUS'];

            let csv = headers.map(h => '"' + h + '"').join(',') + '\n';

            dataRows.forEach(row => {
                if (row.querySelector('.matrix-empty')) return;

                const cells = row.querySelectorAll('td');
                const rowData = [];

                cells.forEach((cell, index) => {
                    if (index === 0 || index === cells.length - 1) return;

                    let text = cell.innerText.trim().replace(/\s+/g, ' ');
                    text = text.replace(/"/g, '""');
                    rowData.push('"' + text + '"');
                });

                if (rowData.length > 0) {
                    csv += rowData.join(',') + '\n';
                }
            });

            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Equipment_Consumables_' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function exportToPdf() {
            const table = document.getElementById('equipmentTable');
            const dataRows = table.querySelectorAll('tbody tr');

            if (dataRows.length === 0 || (dataRows.length === 1 && dataRows[0].querySelector('.matrix-empty'))) {
                alert('No data to export.');
                return;
            }

            const printWindow = window.open('', '_blank');

            let html = '';
            html += '<html><head>';
            html += '<title>Equipment Consumables - ' + new Date().toLocaleDateString() + '</title>';
            html += '<style>';
            html += 'body { font-family: Arial, sans-serif; padding: 20px; }';
            html += 'h2 { color: #6f42c1; margin-bottom: 5px; }';
            html += 'p { font-size: 11px; color: #666; margin-bottom: 20px; }';
            html += 'table { width: 100%; border-collapse: collapse; font-size: 10px; }';
            html += 'th { background: #6f42c1; color: white; padding: 8px 6px; text-align: left; border: 1px solid #ccc; font-weight: 700; }';
            html += 'td { padding: 8px 6px; border: 1px solid #ddd; vertical-align: middle; }';
            html += 'tr:nth-child(even) { background: #fafafa; }';
            html += '</style>';
            html += '</head><body>';
            html += '<h2>Equipment Consumables Matrix</h2>';
            html += '<p>Generated: ' + new Date().toLocaleString() + '</p>';
            html += '<table>';
            html += '<thead><tr>';
            html += '<th>PROJECT</th>';
            html += '<th>TEST ITEM / REQUIREMENT</th>';
            html += '<th>ASSIGNED EQUIPMENT</th>';
            html += '<th>STORAGE LOCATION</th>';
            html += '<th>AVAILABLE QTY</th>';
            html += '<th>ALERT MIN</th>';
            html += '<th>UNIT PRICE</th>';
            html += '<th>SPEC. CYCLES</th>';
            html += '<th>STATUS</th>';
            html += '</tr></thead>';
            html += '<tbody>';

            dataRows.forEach(row => {
                if (row.querySelector('.matrix-empty')) return;

                const cells = row.querySelectorAll('td');
                if (cells.length < 11) return;

                html += '<tr>';
                html += '<td>' + cells[1].innerText.trim() + '</td>';
                html += '<td>' + cells[2].innerText.trim() + '</td>';
                html += '<td>' + cells[3].innerText.trim() + '</td>';
                html += '<td>' + cells[4].innerText.trim() + '</td>';
                html += '<td>' + cells[5].innerText.trim() + '</td>';
                html += '<td>' + cells[6].innerText.trim() + '</td>';
                html += '<td>' + cells[7].innerText.trim() + '</td>';
                html += '<td>' + cells[8].innerText.trim() + '</td>';
                html += '<td>' + cells[9].innerText.trim() + '</td>';
                html += '</tr>';
            });

            html += '<\/tbody></table>';
            html += '<\/body></html>';

            printWindow.document.open();
            printWindow.document.write(html);
            printWindow.document.close();

            setTimeout(function () {
                printWindow.focus();
                printWindow.print();
            }, 500);
        }

                function openEquipmentImage(imageUrl, imageAlt) {
            if (!imageUrl) {
                return;
            }

            const modal = document.getElementById("equipmentImageModal");
            const largeImage = document.getElementById("equipmentImageLarge");
            const caption = document.getElementById("equipmentImageCaption");

            if (!modal || !largeImage) {
                return;
            }

            largeImage.src = imageUrl;
            largeImage.alt = imageAlt || "Equipment Spare Photo";

            if (caption) {
                caption.textContent = imageAlt || "Equipment Spare Photo";
            }

            modal.classList.add("active");
            document.body.classList.add("equipment-image-modal-open");
        }

        function hideEquipmentImage() {
            const modal = document.getElementById("equipmentImageModal");
            const largeImage = document.getElementById("equipmentImageLarge");

            if (modal) {
                modal.classList.remove("active");
            }

            document.body.classList.remove("equipment-image-modal-open");

            if (largeImage) {
                largeImage.src = "";
            }
        }

        // Close when clicking outside the image
        function closeEquipmentImage(event) {
            if (event.target.id === "equipmentImageModal") {
                hideEquipmentImage();
            }
        }

        // Close using Escape key
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                hideEquipmentImage();
            }
        });



        async function openPurchaseHistory(button) {
            const modal = document.getElementById("purchaseHistoryModal");
            const itemId = button.dataset.id;

            document.getElementById("historyItemTitle").textContent =
                button.dataset.name || "Purchase History";

            document.getElementById("historyItemName").textContent =
                button.dataset.name || "—";

            document.getElementById("historyProject").textContent =
                button.dataset.project || "—";

            document.getElementById("historyEquipment").textContent =
                button.dataset.equipment || "—";

            document.getElementById("historyLocation").textContent =
                button.dataset.location || "—";

            document.getElementById("historyPrice").textContent =
                "₹" + (button.dataset.price || "0.00");

            document.getElementById("historyQuantity").textContent =
                (button.dataset.quantity || "0") + " Sets";

            document.getElementById("historyCycles").textContent =
                button.dataset.cycles || "—";

            const photo = document.getElementById("historyItemPhoto");
            const placeholder = document.getElementById("historyPhotoPlaceholder");

            photo.onerror = () => {
                photo.hidden = true;
                photo.removeAttribute("src");
                placeholder.hidden = false;
            };

            if (button.dataset.photo) {
                photo.src = button.dataset.photo;
                photo.hidden = false;
                placeholder.hidden = true;
            } else {
                photo.hidden = true;
                photo.removeAttribute("src");
                placeholder.hidden = false;
            }

            modal.classList.add("active");
            modal.setAttribute("aria-hidden", "false");
            document.body.classList.add("purchase-history-open");

            const rows = document.getElementById("purchaseHistoryRows");
            rows.replaceChildren();

            const loadingRow = document.createElement("tr");
            const loadingCell = document.createElement("td");
            loadingCell.colSpan = 5;
            loadingCell.className = "history-message";
            loadingCell.textContent = "Loading purchase history...";
            loadingRow.appendChild(loadingCell);
            rows.appendChild(loadingRow);

            try {
                // This endpoint must return purchase history for this equipment ID.
                const response = await fetch(
                    '@Url.Action("PurchaseHistory", "Equipment")?id=' +
                    encodeURIComponent(itemId),
                    { headers: { "Accept": "application/json" } }
                );

                if (!response.ok) {
                    throw new Error("Unable to retrieve purchase history.");
                }

                const records = await response.json();

                // Ignore a response if the user has already opened another item.
                if (!modal.classList.contains("active") ||
                    document.getElementById("historyItemTitle").textContent !==
                    (button.dataset.name || "Purchase History")) {
                    return;
                }

                rows.replaceChildren();

                if (!Array.isArray(records) || records.length === 0) {
                    showHistoryMessage(rows, "No previous purchase records found.");
                    return;
                }

                records.forEach(record => {
                    const tr = document.createElement("tr");

                    [
                        record.date,
                        record.prNo,
                        record.quantity,
                        record.totalCost,
                        record.status
                    ].forEach((value, index) => {
                        const td = document.createElement("td");
                        td.textContent = value ?? "—";

                        if (index === 1) {
                            td.className = "history-pr-number";
                        }

                        tr.appendChild(td);
                    });

                    rows.appendChild(tr);
                });
            } catch (error) {
                rows.replaceChildren();
                showHistoryMessage(
                    rows,
                    "Purchase history could not be loaded. Please check the server endpoint."
                );
                console.error(error);
            }
        }

        function showHistoryMessage(tbody, message) {
            const tr = document.createElement("tr");
            const td = document.createElement("td");

            td.colSpan = 5;
            td.className = "history-message";
            td.textContent = message;

            tr.appendChild(td);
            tbody.appendChild(tr);
        }

        function closePurchaseHistory() {
            const modal = document.getElementById("purchaseHistoryModal");

            modal.classList.remove("active");
            modal.setAttribute("aria-hidden", "true");
            document.body.classList.remove("purchase-history-open");
        }

        document.getElementById("purchaseHistoryModal")
            .addEventListener("click", function (event) {
                if (event.target === this) {
                    closePurchaseHistory();
                }
            });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closePurchaseHistory();
            }
        });

    </script>
}