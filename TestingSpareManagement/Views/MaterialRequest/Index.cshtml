@model TestingSpareManagement.Models.MaterialRequestViewModel

@{
    ViewData["Title"] = "Material Request";
}

<link rel="stylesheet"
      href="~/css/material-request.css"
      asp-append-version="true" />

<div class="material-request-page-wrapper">

    <!-- ========================================================= -->
    <!-- LEFT PANEL: REQUEST NEW SPARE / MATERIAL                  -->
    <!-- ========================================================= -->
    <div class="request-panel">
        <h5><i class="fa-solid fa-file-pen"></i> Request New Spare / Material</h5>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="font-size: 0.85rem; padding: 10px;">
                ✅ @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="MaterialRequest" asp-action="Submit" method="post">
            @Html.AntiForgeryToken()

            <!-- Calendar Section -->
            <div class="form-group">
                <label><i class="fa-solid fa-calendar-days"></i> Select Request Date</label>
                <div class="calendar-header">
                    <button type="button"><i class="fa-solid fa-chevron-left"></i> Prev</button>
                    <span>@Model.RequestDate.ToString("MMMM yyyy")</span>
                    <button type="button">Next <i class="fa-solid fa-chevron-right"></i></button>
                </div>

                <input asp-for="RequestDate" type="date" class="form-control-custom" style="margin-top: 8px;" />
            </div>

            <!-- Target Project Code -->
            <div class="form-group">
                <label><i class="fa-solid fa-folder"></i> Target Project Code</label>
                <select asp-for="ProjectCode" class="form-control-custom">
                    <option value="A246F">A246F</option>
                    <option value="B112G">B112G</option>
                    <option value="C089H">C089H</option>
                </select>
                <span asp-validation-for="ProjectCode" class="text-danger small"></span>
            </div>

            <!-- Spare Description -->
            <div class="form-group">
                <label>Spare / Connector Description</label>
                <input asp-for="SpareDescription" class="form-control-custom" placeholder="e.g. Multimount cylinder" />
                <span asp-validation-for="SpareDescription" class="text-danger small"></span>
            </div>

            <!-- Part Number -->
            <div class="form-group">
                <label>Part Number (Part No)</label>
                <input asp-for="PartNumber" class="form-control-custom" placeholder="e.g. TCL120X30" />
                <span asp-validation-for="PartNumber" class="text-danger small"></span>
            </div>

            <!-- Brand -->
            <div class="form-group">
                <label>Brand / Manufacturer</label>
                <input asp-for="Brand" class="form-control-custom" placeholder="e.g. Airtac, Foxlink" />
            </div>

            <!-- Machine / Target Station -->
            <div class="form-group">
                <label>Machine / Target Station</label>
                <select asp-for="TargetMachine" class="form-control-custom">
                    <option value="OS">OS</option>
                    <option value="ATE">ATE</option>
                    <option value="FCT">FCT</option>
                </select>
                <span asp-validation-for="TargetMachine" class="text-danger small"></span>
            </div>

            <!-- Requested Quantity -->
            <div class="form-group">
                <label>Requested Quantity (Pcs/Sets)</label>
                <input asp-for="RequestedQuantity" type="number" class="form-control-custom" placeholder="e.g. 2" />
                <span asp-validation-for="RequestedQuantity" class="text-danger small"></span>
            </div>

            <!-- Priority Level -->
            <div class="form-group">
                <label>Requirement Priority Level</label>
                <select asp-for="PriorityLevel" class="form-control-custom">
                    <option value="Normal Reorder">Normal Reorder</option>
                    <option value="Urgent">Urgent</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>

            <!-- Justification -->
            <div class="form-group">
                <label>Justification / Reason for Request</label>
                <textarea asp-for="Justification" class="form-control-custom" rows="3" placeholder="Explain line requirement..."></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-submit-request">
                Submit Request to Admin via Mail
            </button>
        </form>
    </div>

    <!-- ========================================================= -->
    <!-- RIGHT PANEL: MATERIAL REQUISITION QUEUE                   -->
    <!-- ========================================================= -->
    <div class="queue-panel">
        <div class="queue-header">
            <h5><i class="fa-solid fa-list-check"></i> Material Requisition Requests Queue</h5>
        </div>

        <div class="queue-table-container">
            <table class="queue-table" id="materialRequestTable">
                <thead>
                    <tr>
                        <th>REQ ID</th>
                        <th>REQ DATE</th>
                        <th>PROJECT</th>
                        <th>REQUESTED BY</th>
                        <th>SPARE DESCRIPTION</th>
                        <th>PART NO</th>
                        <th>BRAND</th>
                        <th>TARGET MACHINE</th>
                        <th>QTY</th>
                        <th>PRIORITY</th>
                        <th>STATUS</th>
                        <th>ADMIN ACTIONS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Requests != null && Model.Requests.Any())
                    {
                        foreach (var item in Model.Requests)
                        {
                            <tr>
                                <td><strong>@item.ReqId</strong></td>
                                <td>@item.RequestDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.ProjectCode</td>
                                <td>@item.RequestedBy</td>
                                <td>@item.SpareDescription</td>
                                <td>@item.PartNumber</td>
                                <td>@item.Brand</td>
                                <td>@item.TargetMachine</td>
                                <td><strong>@item.RequestedQuantity</strong></td>
                                <td>
                                    @if (item.PriorityLevel == "Urgent" || item.PriorityLevel == "Critical")
                                    {
                                        <span class="priority-urgent">@item.PriorityLevel</span>
                                    }
                                    else
                                    {
                                        <span class="priority-normal">@item.PriorityLevel</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Approved & PR Created")
                                    {
                                        <span class="status-badge status-approved">@item.Status</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="status-badge status-rejected">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">@item.Status</span>
                                    }
                                </td>
                                <td>@item.AdminActions</td>
                                <td>
                                    <button type="button" class="btn-matrix-del"
                                            onclick="deleteRequest(@item.Id)"
                                            title="Delete Request">
                                        <i class="fa-solid fa-trash"></i> Del
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13">
                                <div class="empty-state">
                                    <i class="fa-solid fa-inbox"></i>
                                    No material requests found. Submit a request using the form.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Calendar date cell click (highlight only)
        document.querySelectorAll('.date-cell').forEach(cell => {
            cell.addEventListener('click', function () {
                document.querySelectorAll('.date-cell').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // =====================================================
        // DELETE REQUEST
        // =====================================================
        function deleteRequest(id) {
            if (!id || id <= 0) return;

            if (!confirm('Are you sure you want to delete this material request?')) return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete", "MaterialRequest")';

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const t = document.createElement('input');
                t.type = 'hidden';
                t.name = '__RequestVerificationToken';
                t.value = token.value;
                form.appendChild(t);
            }

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = id;
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }
    </script>
}